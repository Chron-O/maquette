// The shell, following the HTML prototype: a home page, the club pages, and one event
// with its tabs. Rust owns the state; this file shows it and sends the clicks back.

import { Theme, ThemeMode } from "theme.slint";
import { Card } from "components/card.slint";
import { HeaderButton } from "components/header-button.slint";
import { PrimaryButton, SecondaryButton } from "components/buttons.slint";
import { Tabs, IconTabs, TabItem } from "components/tabs.slint";
import { Icons } from "components/icons.slint";
export { Theme, ThemeMode, Icons, TabItem }

export struct EventItem {
    name: string,
    detail: string,
}

// What Rust gives to the screen, and the clicks it gets back.
export global Navigation {
    in property <bool> home;
    in property <bool> in-event;
    in property <string> header-title;
    in property <string> back-label;
    in property <string> page-title;
    in property <[EventItem]> events;
    in property <[string]> club-pages;
    in property <[TabItem]> tabs;
    in property <int> active-tab;
    callback open-event(int);
    callback open-club-page(int);
    callback select-tab(int);
    callback go-back();
}

// The demo setting: only touch or mouse can be forced.
export global Demo {
    in property <[TabItem]> devices;
    in property <int> active-device;
    callback select-device(int);
}

enum LayoutMode { narrow, medium, wide }

component Header inherits Rectangle {
    in property <LayoutMode> layout-mode;
    in property <length> left-margin;
    in property <length> right-margin;
    in property <length> top-margin;

    background: Theme.header;
    HorizontalLayout {
        padding-top: root.top-margin + Theme.space;
        padding-bottom: Theme.space;
        padding-left: root.left-margin;
        padding-right: root.right-margin;
        spacing: Theme.space-medium;
        if !Navigation.home: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HeaderButton {
                label: root.layout-mode == LayoutMode.narrow ? "‹" : "‹ " + Navigation.back-label;
                arrow-only: root.layout-mode == LayoutMode.narrow;
                clicked => { Navigation.go-back(); }
            }
        }
        Text {
            horizontal-stretch: 1;
            min-height: Theme.zone;
            text: Navigation.header-title;
            color: Theme.header-text;
            font-size: Theme.text-screen-title;
            font-weight: Theme.weight-screen-title;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: Theme.text-screen-title;
    font-weight: Theme.weight-screen-title;
    wrap: word-wrap;
}

component EventsSection {
    in property <length> card-margin;

    VerticalLayout {
        alignment: start;
        spacing: Theme.space-medium;
        SectionTitle { text: "Événements"; }
        for event[i] in Navigation.events: Card {
            title: event.name;
            margin: root.card-margin;
            Text {
                text: event.detail;
                color: Theme.text-secondary;
                font-size: Theme.text-body;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                PrimaryButton {
                    label: "Ouvrir l'événement";
                    clicked => { Navigation.open-event(i); }
                }
            }
        }
    }
}

component ClubSection {
    in property <length> card-margin;

    VerticalLayout {
        alignment: start;
        spacing: Theme.space-medium;
        SectionTitle { text: "Le club"; }
        for page[i] in Navigation.club-pages: Card {
            title: page;
            margin: root.card-margin;
            HorizontalLayout {
                alignment: start;
                SecondaryButton {
                    label: "Ouvrir";
                    clicked => { Navigation.open-club-page(i); }
                }
            }
        }
    }
}

// Two columns when wide, one otherwise (01-accueil.png).
component HomePage {
    in property <LayoutMode> layout-mode;
    in property <length> card-margin;

    // A layout around the two `if`: without it, Slint does not pass the height up
    // and the page cannot scroll.
    VerticalLayout {
        if root.layout-mode == LayoutMode.wide: HorizontalLayout {
            spacing: Theme.margin;
            EventsSection {
                horizontal-stretch: 1;
                card-margin: root.card-margin;
            }
            ClubSection {
                horizontal-stretch: 0;
                width: Theme.club-column-width;
                card-margin: root.card-margin;
            }
        }
        if root.layout-mode != LayoutMode.wide: VerticalLayout {
            spacing: Theme.margin;
            EventsSection { card-margin: root.card-margin; }
            ClubSection { card-margin: root.card-margin; }
        }
    }
}

component Page {
    in property <LayoutMode> layout-mode;
    in property <length> left-margin;
    in property <length> right-margin;
    in property <length> bottom-margin;

    // The home page stays centered on large windows (01-accueil.png).
    property <length> home-inset: Navigation.home ? max(0px, (root.width - Theme.home-max-width) / 2) : 0px;

    scroller := Flickable {
        content := VerticalLayout {
            width: scroller.width;
            alignment: start;
            padding-top: Theme.space-medium;
            padding-left: max(root.left-margin, root.home-inset);
            padding-right: max(root.right-margin, root.home-inset);
            padding-bottom: root.bottom-margin + Theme.space-medium;
            if !Navigation.home: SectionTitle { text: Navigation.page-title; }
            if Navigation.home: HomePage {
                layout-mode: root.layout-mode;
                card-margin: root.layout-mode == LayoutMode.narrow ? Theme.narrow-margin : Theme.card-margin;
            }
        }
        content-height: max(self.height, content.preferred-height);
    }
}

component DemoRow {
    in property <string> label;
    in property <string> value;

    HorizontalLayout {
        spacing: Theme.space;
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.text-label;
            font-weight: Theme.weight-regular;
        }
        Text {
            horizontal-stretch: 1;
            horizontal-alignment: right;
            text: root.value;
            color: Theme.text;
            font-size: Theme.text-label;
            font-weight: Theme.weight-label;
            wrap: word-wrap;
        }
    }
}

component DemoPanel {
    in property <string> layout-name;
    in property <length> window-width;

    Card {
        title: "Démo";
        margin: Theme.space-medium;
        drop-shadow-blur: Theme.demo-shadow;
        Tabs {
            tabs: Demo.devices;
            active: Demo.active-device;
            clicked(i) => { Demo.select-device(i); }
        }
        DemoRow {
            label: "Tailles";
            value: (Theme.touch ? "Tactile, " : "Souris, ") + Theme.zone / 1px + " px";
        }
        DemoRow {
            label: "Disposition";
            value: root.layout-name + ", " + floor(root.window-width / 1px) + " px";
        }
        DemoRow {
            label: "Thème";
            value: Theme.dark ? "Sombre" : "Clair";
        }
    }
}

export component App inherits Window {
    title: "Chron'O — maquette";
    preferred-width: Theme.window-width;
    preferred-height: Theme.window-height;
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;
    background: Theme.page-background;
    default-font-family: Theme.font;

    in-out property <bool> demo-open: false;

    property <LayoutMode> layout-mode: root.width < Theme.medium-threshold ? LayoutMode.narrow
        : root.width <= Theme.wide-threshold ? LayoutMode.medium
        : LayoutMode.wide;
    property <length> margin: root.layout-mode == LayoutMode.narrow ? Theme.narrow-margin : Theme.margin;
    property <length> left-margin: root.margin + root.safe-area-insets.left;
    property <length> right-margin: root.margin + root.safe-area-insets.right;

    // Explicit size: the layout's own minimum must not feed back into the window width,
    // which picks the layout mode. The window minimum above stays the only limit.
    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        Header {
            vertical-stretch: 0;
            layout-mode: root.layout-mode;
            left-margin: root.left-margin;
            right-margin: root.right-margin;
            top-margin: root.safe-area-insets.top;
        }
        if Navigation.in-event: HorizontalLayout {
            vertical-stretch: 0;
            padding-top: Theme.space-medium;
            padding-left: root.layout-mode == LayoutMode.narrow ? Theme.space + root.safe-area-insets.left : root.left-margin;
            padding-right: root.layout-mode == LayoutMode.narrow ? Theme.space + root.safe-area-insets.right : root.right-margin;
            alignment: root.layout-mode == LayoutMode.narrow ? stretch : start;
            if root.layout-mode == LayoutMode.narrow: IconTabs {
                tabs: Navigation.tabs;
                active: Navigation.active-tab;
                clicked(i) => { Navigation.select-tab(i); }
            }
            if root.layout-mode != LayoutMode.narrow: Tabs {
                tabs: Navigation.tabs;
                active: Navigation.active-tab;
                clicked(i) => { Navigation.select-tab(i); }
            }
        }
        Page {
            vertical-stretch: 1;
            layout-mode: root.layout-mode;
            left-margin: root.left-margin;
            right-margin: root.right-margin;
            // Keeps the end of the page clear of the Démo button.
            bottom-margin: Theme.zone + root.safe-area-insets.bottom + Theme.space-medium;
        }
    }

    // Closes the panel when clicking anywhere else.
    if root.demo-open: TouchArea {
        clicked => { root.demo-open = false; }
    }

    if root.demo-open: DemoPanel {
        x: root.left-margin;
        y: demo-button.y - self.preferred-height - Theme.space;
        width: min(Theme.demo-width, root.width - root.left-margin - root.right-margin);
        height: self.preferred-height;
        layout-name: root.layout-mode == LayoutMode.narrow ? "Étroite"
            : root.layout-mode == LayoutMode.medium ? "Moyenne"
            : "Large";
        window-width: root.width;
    }

    demo-button := SecondaryButton {
        x: root.left-margin;
        y: root.height - self.height - root.safe-area-insets.bottom - Theme.space;
        height: Theme.zone;
        label: "Démo";
        clicked => { root.demo-open = !root.demo-open; }
    }
}
