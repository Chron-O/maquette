// The reader tile (prototype: tile, .tile): one dark green tile wherever a reader is shown.
// Line 1 names the reader and its serial number, with its pin; line 2 says what it does now.
// In a left panel, a zone of fixed height comes under the two lines (the medium format):
// the tile never changes height with its state (encart-lecture.md § 11).

import { Theme } from "../theme.slint";
import { Icons } from "icons.slint";
import { ReaderRings } from "dot.slint";
import { PrimaryButton, SecondaryButton } from "buttons.slint";

// What a reader is doing. `none`: no reader there (no test data).
export enum ReaderMode { none, ready, reading, unplugged }

export struct ReaderInfo {
    index: int,        // to pin it
    name: string,
    serial: string,    // "n° 539154"
    pinned: bool,      // a window waiting for a card does not take it by itself
    mode: ReaderMode,
}

// The readers of this device, given by Rust.
export global Readers {
    in property <[ReaderInfo]> finish;   // the event's finish readers (Direct)
    in property <ReaderInfo> entry;      // the entry desk (Participants)
    in property <ReaderInfo> free;       // a free reader (Boîtiers, club pages)
    callback toggle-pin(int);

    public pure function state-word(reader: ReaderInfo) -> string {
        if reader.mode == ReaderMode.unplugged {
            return "Débranché : rebranchez le câble USB";
        }
        if reader.mode == ReaderMode.reading {
            return "Lecture en cours…";
        }
        if reader.mode == ReaderMode.ready {
            return "Prêt";
        }
        return "Aucun lecteur branché";
    }
}

// What was read, in the result zone.
export enum ReaderState {
    waiting,   // nothing read yet: the message
    read,      // the number in big, the identity and the verdict
    unknown,   // the same in amber: "à ranger"
}

// The pin of a reader: pinned in full, not pinned faint, so that it stays findable.
component PinToggle {
    in property <ReaderInfo> reader;
    in property <color> tone;

    width: Theme.reader-pin-icon;
    height: Theme.reader-pin-icon;
    accessible-role: button;
    accessible-checkable: true;
    accessible-checked: root.reader.pinned;
    accessible-label: root.reader.pinned ? "Épinglé : une fenêtre ne le prend pas toute seule" : "Non épinglé";
    accessible-action-default => { Readers.toggle-pin(root.reader.index); }
    Image {
        source: root.reader.pinned ? Icons.pin : Icons.pin-off;
        colorize: root.tone;
        opacity: root.reader.pinned ? 1 : Theme.reader-pin-off-opacity;
        width: 100%;
        height: 100%;
    }
    TouchArea {
        x: -Theme.reader-pin-hit;
        y: -Theme.reader-pin-hit;
        width: root.width + 2 * Theme.reader-pin-hit;
        height: root.height + 2 * Theme.reader-pin-hit;
        mouse-cursor: pointer;
        clicked => { Readers.toggle-pin(root.reader.index); }
    }
}

// The two lines of a reader: its name and number with its pin, then what it does now.
// One line each, ended by "…" if too long (encart-lecture.md § 11).
component ReaderLines inherits VerticalLayout {
    in property <ReaderInfo> reader;
    in property <string> second;          // replaces the state word: a number read with a question
    in property <color> second-color: Theme.header-text;

    alignment: center;
    spacing: Theme.reader-line-gap;
    Text {
        text: root.reader.name == "" ? "" : root.reader.name + " · " + root.reader.serial;
        color: Theme.reader-detail;
        font-size: Theme.text-help;
        font-weight: Theme.weight-block-title;
        overflow: elide;
    }
    // The pin at the end of the short line, so that the name and its number keep the width.
    HorizontalLayout {
        spacing: Theme.space-small;
        Text {
            horizontal-stretch: 1;
            text: root.second != "" ? root.second : Readers.state-word(root.reader);
            color: root.reader.mode == ReaderMode.unplugged ? Theme.reader-error : root.second != "" ? root.second-color : Theme.header-text;
            font-size: Theme.text-label;
            font-weight: Theme.weight-screen-title;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.reader.name != "": VerticalLayout {
            alignment: center;
            PinToggle {
                reader: root.reader;
                tone: Theme.reader-detail;
            }
        }
    }
}

// The reader tile of a left panel (Robin, 11/11: the medium format, the same on every screen).
// Under the two lines, one zone of fixed height: what to do, or the number read and its verdict,
// or the buttons of a question; then the number goes up in place of the state word.
// The tile never changes height (encart-lecture.md § 11).
export component ReaderTile inherits Rectangle {
    callback primary-clicked();
    callback secondary-clicked();

    in property <ReaderInfo> reader;
    in property <bool> compact;          // the Direct, phones
    in property <bool> with-result;      // the zone under the two lines
    in property <bool> stations;         // reads stations, not cards: a thick orange outline (Robin, 11/11)
    in property <ReaderState> state: ReaderState.waiting;
    in property <string> message;        // waiting: what to do
    in property <string> code;           // read, unknown: the number, in big
    in property <string> identity;       // who or what it is
    in property <string> verdict;        // in the state's color
    in property <string> primary-label;  // a question to settle now: two buttons at most
    in property <string> secondary-label;

    property <bool> unplugged: root.reader.mode == ReaderMode.unplugged;
    property <bool> has-buttons: root.primary-label != "" || root.secondary-label != "";
    property <bool> shows-result: root.state != ReaderState.waiting;
    property <color> accent: root.unplugged ? Theme.reader-error : Theme.reader-ring;
    property <color> state-color: root.state == ReaderState.unknown ? Theme.reader-unknown : Theme.reader-ring;
    // The state's outline wins over the stations' one.
    property <bool> state-outline: root.unplugged || root.reader.mode == ReaderMode.reading || root.state == ReaderState.unknown;
    property <string> summary: root.verdict != "" ? root.verdict : root.identity;

    background: root.unplugged ? Theme.reader-error-background : Theme.header;
    border-radius: Theme.card-radius;
    // Light: a clear shadow all around, no outline. Dark: the light green outline.
    // A screen of stations: a thick orange outline, unless a state shows its own.
    border-width: root.stations ? Theme.reader-stations-outline-width
        : root.state-outline ? max(Theme.reader-outline-width, Theme.reader-state-outline-width)
        : Theme.reader-outline-width;
    border-color: root.unplugged ? Theme.reader-error
        : root.reader.mode == ReaderMode.reading ? Theme.reader-ring
        : root.state == ReaderState.unknown ? Theme.reader-unknown
        : root.stations ? Theme.reader-stations-outline
        : root.accent;
    drop-shadow-blur: Theme.reader-shadow-blur;
    drop-shadow-color: Theme.reader-shadow;
    accessible-role: groupbox;
    accessible-label: root.reader.name;

    VerticalLayout {
        padding-left: root.compact ? Theme.reader-compact-padding-x : Theme.reader-padding;
        padding-right: self.padding-left;
        padding-top: root.compact ? Theme.reader-compact-padding-y : Theme.reader-padding-y;
        padding-bottom: self.padding-top;
        spacing: Theme.space;
        HorizontalLayout {
            spacing: Theme.space;
            // Not clipped: the waves leave the target.
            VerticalLayout {
                alignment: center;
                ReaderRings {
                    size: root.compact ? Theme.reader-line-icon : Theme.reader-icon;
                    tone: root.accent;
                    period: root.reader.mode == ReaderMode.reading ? Theme.reader-reading-period : Theme.reader-wave-period;
                    still: root.reader.mode != ReaderMode.ready && root.reader.mode != ReaderMode.reading;
                    crossed: root.unplugged;
                }
            }
            ReaderLines {
                horizontal-stretch: 1;
                reader: root.reader;
                second: root.has-buttons && root.shows-result ? root.code + " · " + root.summary : "";
                second-color: root.state-color;
            }
        }
        if root.with-result: Rectangle {
            height: Theme.reader-zone-height;
            if !root.shows-result && !root.has-buttons: Text {
                width: parent.width;
                height: parent.height;
                text: root.message;
                color: Theme.reader-detail;
                font-size: Theme.text-label;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.shows-result && !root.has-buttons: VerticalLayout {
                alignment: center;
                Text {
                    text: root.code;
                    color: root.state == ReaderState.unknown ? Theme.reader-unknown : Theme.header-text;
                    font-size: Theme.reader-code-small-size;
                    font-weight: Theme.weight-screen-title;
                    overflow: elide;
                }
                Text {
                    text: root.summary;
                    color: root.state-color;
                    font-size: Theme.text-help;
                    font-weight: Theme.weight-block-title;
                    overflow: elide;
                }
            }
            // A question: its buttons slide into the zone.
            HorizontalLayout {
                y: root.has-buttons ? (parent.height - Theme.zone) / 2 : parent.height;
                animate y { duration: Theme.reader-shift-duration; }
                opacity: root.has-buttons ? 1 : 0;
                animate opacity { duration: Theme.reader-shift-duration; }
                height: Theme.zone;
                alignment: start;
                spacing: Theme.space;
                if root.primary-label != "": PrimaryButton {
                    in-row: true;
                    label: root.primary-label;
                    clicked => { root.primary-clicked(); }
                }
                if root.secondary-label != "": SecondaryButton {
                    label: root.secondary-label;
                    clicked => { root.secondary-clicked(); }
                }
            }
        }
    }
}

// The compact reader, in the Direct bar and on the home page. Its size never changes with what
// the reader does by itself (charte-ui, rule 16): no word comes and goes after its name.
// Reading: fast waves and a green bar that moves along its foot (encart-lecture.md: « barre
// verte qui avance »). Unplugged: red, the target crossed out. The words go to screen readers;
// in the drawer, the full tiles say them. `label`: another fixed text (the phone drawer).
export component BarReader inherits Rectangle {
    in property <ReaderInfo> reader;
    in property <string> label: root.reader.name;
    in property <bool> show-pin: true;
    in property <bool> raised;   // on the light green Direct: dark, with its shadow, like the tiles

    property <bool> unplugged: root.reader.mode == ReaderMode.unplugged;
    property <bool> reading: root.reader.mode == ReaderMode.reading;
    property <float> run: Math.mod(animation-tick() / 1ms, Theme.reader-bar-period / 1ms) / (Theme.reader-bar-period / 1ms);

    height: Theme.reader-compact-icon + Theme.space;
    border-radius: Theme.reader-compact-radius;
    clip: true;
    background: root.unplugged ? Theme.reader-error-background : root.raised ? Theme.reader-raised-pill : Theme.direct-pill;
    drop-shadow-blur: root.raised ? Theme.reader-compact-shadow-blur : 0px;
    drop-shadow-color: Theme.reader-shadow;
    border-width: Theme.reader-outline-width;
    border-color: root.unplugged ? Theme.reader-error : Theme.reader-ring;
    accessible-role: text;
    accessible-label: root.reader.name + " : " + Readers.state-word(root.reader);
    HorizontalLayout {
        padding-left: Theme.space-small;
        padding-right: Theme.button-margin;
        spacing: Theme.space-small;
        VerticalLayout {
            alignment: center;
            ReaderRings {
                size: Theme.reader-compact-icon;
                tone: root.unplugged ? Theme.reader-error : Theme.reader-ring;
                period: root.reading ? Theme.reader-reading-period : Theme.reader-wave-period;
                still: root.unplugged;
                crossed: root.unplugged;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.header-text;
            font-size: Theme.text-help;
            font-weight: Theme.weight-block-title;
            vertical-alignment: center;
        }
        if root.show-pin && root.reader.pinned: VerticalLayout {
            alignment: center;
            Image {
                source: Icons.pin;
                colorize: Theme.reader-detail;
                width: Theme.reader-pin-icon;
                height: Theme.reader-pin-icon;
                accessible-role: image;
                accessible-label: "Épinglé";
            }
        }
    }
    // Reading: the bar along its foot, inside the tile.
    if root.reading: Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width * (Theme.reduced-motion ? 1 : root.run);
        height: Theme.reader-bar-height;
        background: Theme.reader-ring;
    }
}
