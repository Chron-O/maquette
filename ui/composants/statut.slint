import { Theme, FamilleEtat } from "../theme.slint";
import { Icones } from "icones.slint";
import { PointVivant } from "point.slint";

// A status = a family (the color) + an icon + a word.
// `point`: "En course" shows a solid dot instead of an icon (02-participants.png).
export struct Statut {
    mot: string,
    etat: FamilleEtat,
    icone: image,
    point: bool,
}

export global Statuts {
    out property <Statut> ok: { mot: "OK", etat: Theme.valide, icone: Icones.check };
    out property <Statut> en-course: { mot: "En course", etat: Theme.en-cours, point: true };
    out property <Statut> inconnue: { mot: "Inconnue", etat: Theme.a-verifier, icone: Icones.circle-help };
    out property <Statut> pm: { mot: "PM", etat: Theme.probleme, icone: Icones.x };
    out property <Statut> abandon: { mot: "Abandon", etat: Theme.inactif, icone: Icones.log-out };
    out property <Statut> deja-lue: { mot: "Déjà lue", etat: Theme.a-verifier, icone: Icones.triangle-alert };
}

// Status badge: small pill, icon + word.
export component PastilleStatut inherits Rectangle {
    in property <Statut> statut;

    height: Theme.hauteur-badge;
    border-radius: self.height / 2;
    background: statut.etat.badge-fond;
    HorizontalLayout {
        padding-left: Theme.marge-badge;
        padding-right: Theme.marge-badge;
        spacing: statut.point ? Theme.espace-petit : Theme.espace-icone-badge;
        VerticalLayout {
            alignment: center;
            if statut.point: PointVivant {
                taille: Theme.point-badge;
                couleur: statut.etat.badge-texte;
            }
            if !statut.point: Image {
                source: statut.icone;
                colorize: statut.etat.badge-texte;
                width: Theme.icone-badge;
                height: Theme.icone-badge;
            }
        }
        Text {
            text: statut.mot;
            color: statut.etat.badge-texte;
            font-size: Theme.texte-aide;
            font-weight: Theme.graisse-titre-bloc;
            vertical-alignment: center;
        }
    }
}

// Status block: fixed width, icon above the full word (08-direct.png).
export component PaveStatut inherits Rectangle {
    in property <Statut> statut;

    width: Theme.largeur-pave;
    height: Theme.hauteur-pave;
    border-radius: Theme.rayon-pave;
    background: statut.etat.pave-fond;
    VerticalLayout {
        alignment: center;
        spacing: Theme.espace-petit;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                height: Theme.icone-pave;
                if statut.point: PointVivant {
                    taille: Theme.point-pave;
                    couleur: statut.etat.pave-texte;
                }
                if !statut.point: Image {
                    source: statut.icone;
                    colorize: statut.etat.pave-texte;
                    width: Theme.icone-pave;
                    height: Theme.icone-pave;
                }
            }
        }
        Text {
            text: statut.mot;
            color: statut.etat.pave-texte;
            font-size: Theme.texte-libelle;
            font-weight: Theme.graisse-titre-ecran;
            horizontal-alignment: center;
        }
    }
}
