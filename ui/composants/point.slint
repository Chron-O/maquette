import { Theme } from "../theme.slint";

// Breathing dot: "En course", Direct. Stays still when the system asks for reduced motion.
export component PointVivant {
    in property <color> couleur;
    in property <length> taille;

    property <float> souffle: Theme.moins-de-mouvements ? 1
        : (1 + Math.sin(animation-tick() / Theme.periode-respiration * 360deg)) / 2;

    width: taille;
    height: taille;

    Rectangle {
        width: root.taille * (Theme.respiration-taille-min + (1 - Theme.respiration-taille-min) * root.souffle);
        height: self.width;
        border-radius: self.width / 2;
        background: root.couleur;
        opacity: Theme.respiration-opacite-min + (1 - Theme.respiration-opacite-min) * root.souffle;
    }
}

// Spinning icon: reading, syncing. Stays still when the system asks for reduced motion.
export component IconeTournante {
    in property <image> source;
    in property <color> couleur;
    in property <length> taille;

    property <angle> angle: Theme.moins-de-mouvements ? 0deg
        : Math.mod(animation-tick() / 1ms, Theme.periode-rotation / 1ms) / (Theme.periode-rotation / 1ms) * 360deg;

    width: taille;
    height: taille;

    Image {
        source: root.source;
        colorize: root.couleur;
        width: root.taille;
        height: root.taille;
        transform-rotation: root.angle;
    }
}
