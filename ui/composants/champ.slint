import { Theme } from "../theme.slint";
import { Icones } from "icones.slint";

// Input field. Idle: surface, no outline. Editing and error: full outline.
// `montrer-saisie` shows the editing state without focus.
export component Champ {
    callback focus-recu();
    // Gives focus back: on a phone, this closes the keyboard.
    public function liberer() { saisie.clear-focus(); }
    in property <string> libelle;
    in property <string> indication;   // gray text while the field is empty
    in-out property <string> texte <=> saisie.text;
    in property <string> erreur;
    in property <bool> montrer-saisie: false;
    in property <InputType> type-saisie: InputType.text;   // picks the phone keyboard

    property <bool> en-erreur: erreur != "";
    property <bool> en-saisie: saisie.has-focus || montrer-saisie;

    VerticalLayout {
        alignment: start;   // top aligned, even when a neighbor shows an error message
        spacing: Theme.espace-petit;
        if root.libelle != "": Text {
            text: root.libelle;
            color: Theme.texte-secondaire;
            font-size: Theme.texte-libelle;
            font-weight: Theme.graisse-lecture;
            wrap: word-wrap;
        }
        Rectangle {
            height: Theme.hauteur-champ;
            border-radius: Theme.rayon-champ;
            background: root.en-saisie || root.en-erreur ? Theme.champ-saisie-fond : Theme.surface;
            border-width: Theme.champ-contour-epaisseur;
            border-color: root.en-erreur ? Theme.champ-erreur-contour
                : root.en-saisie ? Theme.champ-saisie-contour
                : transparent;
            animate background, border-color { duration: Theme.duree-teinte; }
            HorizontalLayout {
                padding-left: Theme.marge-bouton;
                padding-right: Theme.marge-bouton;
                Rectangle {
                    if saisie.text == "": Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.indication;
                        color: Theme.texte-secondaire;
                        font-size: Theme.texte-aide;
                        vertical-alignment: center;
                    }
                    saisie := TextInput {
                        color: Theme.texte;
                        font-size: Theme.texte-courant;
                        font-weight: Theme.graisse-titre-bloc;
                        vertical-alignment: center;
                        single-line: true;
                        input-type: root.type-saisie;
                        accepted => { self.clear-focus(); }   // Return key
                        changed has-focus => {
                            if self.has-focus {
                                root.focus-recu();
                            }
                        }
                    }
                }
            }
        }
        if root.en-erreur: HorizontalLayout {
            spacing: Theme.espace-petit;
            VerticalLayout {
                alignment: center;
                Image {
                    source: Icones.triangle-alert;
                    colorize: Theme.champ-erreur-contour;
                    width: Theme.icone-message;
                    height: Theme.icone-message;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.erreur;
                color: Theme.champ-erreur-contour;
                font-size: Theme.texte-aide;
                font-weight: Theme.graisse-libelle;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
