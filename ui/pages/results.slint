// The Résultats tab, following the HTML prototype and categories-classements.md: the
// rankings in the column, and the chosen one in a table. The detail is the Direct's.

import { Theme } from "../theme.slint";
import { LayoutMode } from "../navigation.slint";
import { InputField } from "../components/field.slint";
import { Icons } from "../components/icons.slint";
import { ChoiceSegments } from "../components/choice-segments.slint";
import { MoreButton } from "../components/buttons.slint";
import { Sheet } from "../components/zones.slint";
import { ActiveFilter, BottomDetail, FilterButton, FilterGroup, FiltersContent, SideDetail, Unfold } from "../components/zones.slint";
import { StatusBadge, StatusBlock } from "../components/status.slint";
import { Badge, Home } from "home.slint";
import { BubbleFrame, BubbleLabel, CourseChip, Courses, MenuItem, RowLine, SearchToggle, SmallText, SummaryZone } from "courses.slint";
import { Cell, NameCell, Participants, SetItem, PanelSet, StatBlock, StatTile } from "participants.slint";
import { ChipFlow, Head, Live, LiveDetail, LiveFilter, MenuHead, RowCell, TimeText } from "live.slint";

export struct ResultRanking {
    index: int,
    label: string,
    tone: int,
    count: string,
}

export struct ResultRow {
    runner: int,
    place: string,
    place-note: string,   // the place as said under the time on a phone (« 3e »)
    family: string,
    first: string,
    club: string,
    category: string,
    time: string,
    gap: string,
    badge: Badge,
    crossed: bool,
    selected: bool,
}

// One ranking, as a column (brief Cowork, 11/11).
export struct ResultColumn {
    index: int,
    title: string,
    tone: int,
    state: string,
    rows: [ResultRow],
}

export global Results {
    in property <[ResultRow]> rows;
    in property <[ResultRanking]> rankings;
    in property <[LiveFilter]> ranking-chips;
    in property <int> active-ranking;
    in property <[LiveFilter]> category-chips;
    in property <int> active-category;
    in property <[string]> chips;
    in property <[FilterGroup]> filter-groups;
    in property <[ActiveFilter]> active-filters;
    callback toggle-filter(int, int);
    callback clear-filters();
    in property <[string]> modes;
    in property <int> active-mode;
    in property <bool> by-course;
    in property <string> title;
    in property <int> title-tone;
    in property <string> state;
    in property <string> empty;
    in property <string> summary;
    in property <string> summary-short;
    in property <string> search-text;
    in property <string> ranking-search-text;
    in-out property <int> menu-row: -1;   // the row whose « ⋯ » menu is open

    in property <[string]> views;              // the panel: Classements, Analyse, Remise des prix
    in property <int> active-view;
    in property <[ResultColumn]> columns;
    in property <int> focus-column: -1;        // the column to bring to the left
    in property <[FilterGroup]> column-filter-groups;
    in property <[ActiveFilter]> column-filters;
    in property <[StatBlock]> stats;
    callback select-view(int);
    callback pick-stat(int, int);
    callback toggle-column-filter(int, int);
    callback clear-column-filters();

    callback select-mode(int);
    callback select-ranking(int);
    callback select-category(int);
    callback search(string);
    callback search-ranking(string);
}

// The « ⋯ » of a row: a small menu, joined to it (prototype: rDots). No effect yet.
component ResultMenuButton {
    in property <int> runner;

    property <bool> open: Courses.open-bubble == 24 && Results.menu-row == root.runner;

    min-width: Theme.small-button-width;
    accessible-role: button;
    accessible-label: "Plus d'actions";
    MoreButton {
        width: 100%;
        height: 100%;
        open: root.open;
        down: Courses.bubble-down;
        clicked => {
            Results.menu-row = root.runner;
            // The menu is joined to the drawn button, not to its touch zone.
            Courses.open-at(24, self.absolute-position.x + (self.width - Theme.small-button-width) / 2,
                self.absolute-position.y + (self.height - Theme.small-button-height) / 2,
                Theme.small-button-width, Theme.small-button-height);
        }
    }
}

// The titles stay at the top: only the rows scroll. The columns of the prototype (tabResultats),
// plain titles: Cat. only in a course ranking; without the room, Club and Écart go under.
component ResultsTable {
    in property <length> available-width;

    property <bool> wide: root.available-width >= Theme.result-full-width;
    property <bool> has-category: root.wide && Results.by-course;
    property <length> fixed: Theme.result-place-width + Theme.result-state-width + Theme.result-time-width + Theme.result-action-width
        + (root.wide ? Theme.result-club-width + Theme.result-gap-width : 0px)
        + (root.has-category ? Theme.result-category-width : 0px);
    property <length> name-width: max(Theme.live-name-width, root.available-width - root.fixed);

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 0;
            height: Theme.table-header-height + Theme.space;
            RowCell { width: Theme.result-place-width; Head { text: "Place"; } }
            RowCell { width: root.name-width; Head { text: "Nom"; } }
            if root.wide: RowCell { width: Theme.result-club-width; Head { text: "Club"; } }
            if root.has-category: RowCell { width: Theme.result-category-width; Head { text: "Cat."; } }
            RowCell { width: Theme.result-time-width; Head { text: "Temps"; } }
            if root.wide: RowCell { width: Theme.result-gap-width; Head { text: "Écart"; } }
            RowCell { width: Theme.result-state-width; Head { text: "État"; } }
            MenuHead { width: Theme.result-action-width; text: "Action"; right: true; }
        }
        RowLine { vertical-stretch: 0; }
        if Results.empty != "": Text {
            vertical-stretch: 1;
            text: Results.empty;
            color: Theme.text-secondary;
            font-size: Theme.text-label;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if Results.empty == "": Flickable {
            vertical-stretch: 1;
            content-height: lines.preferred-height;
            lines := VerticalLayout {
                width: root.available-width;
                alignment: start;
                for row[n] in Results.rows: VerticalLayout {
                    if n > 0: RowLine { }
                    Rectangle {
                        min-height: Theme.zone;
                        background: row.selected ? Theme.row-selected : transparent;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Live.select-runner(row.runner); }
                        }
                        HorizontalLayout {
                            RowCell {
                                width: Theme.result-place-width;
                                Cell { text: row.place; font-weight: Theme.weight-screen-title; }
                            }
                            if root.wide: NameCell { width: root.name-width; family: row.family; first: row.first; }
                            // Without the room for its column, the club goes under the name.
                            if !root.wide: VerticalLayout {
                                width: root.name-width;
                                alignment: center;
                                NameCell { family: row.family; first: row.first; }
                                RowCell { SmallText { text: Results.by-course ? row.club + " · " + row.category : row.club; } }
                            }
                            if root.wide: RowCell { width: Theme.result-club-width; Cell { text: row.club; wrap: word-wrap; } }
                            if root.has-category: RowCell { width: Theme.result-category-width; Cell { text: row.category; } }
                            if root.wide: RowCell {
                                width: Theme.result-time-width;
                                TimeText { time: row.time; crossed: row.crossed; }
                            }
                            if !root.wide: VerticalLayout {
                                width: Theme.result-time-width;
                                alignment: center;
                                RowCell { TimeText { time: row.time; crossed: row.crossed; } }
                                if row.gap != "": RowCell { SmallText { text: row.gap; wrap: no-wrap; } }
                            }
                            if root.wide: RowCell { width: Theme.result-gap-width; Cell { text: row.gap; color: Theme.text-secondary; } }
                            RowCell {
                                width: Theme.result-state-width;
                                VerticalLayout {
                                    alignment: center;
                                    StatusBadge { status: Home.status-of(row.badge); }
                                }
                            }
                            HorizontalLayout {
                                width: Theme.result-action-width;
                                alignment: end;
                                padding-right: Theme.space;
                                ResultMenuButton { runner: row.runner; }
                            }
                        }
                    }
                }
            }
        }
    }
}

// On a phone, the charte's list row (Listes, 03/11): status › who › time, its place under it.
component ResultsList {
    VerticalLayout {
        if Results.empty != "": Text {
            height: Theme.live-card-narrow-height;
            text: Results.empty;
            color: Theme.text-secondary;
            font-size: Theme.text-label;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        for row[n] in Results.rows: VerticalLayout {
            if n > 0: RowLine { }
            Rectangle {
                min-height: Theme.zone;
                background: row.selected ? Theme.row-selected : transparent;
                TouchArea {
                    clicked => { Live.select-runner(row.runner); }
                }
                HorizontalLayout {
                    padding: Theme.space;
                    spacing: Theme.space;
                    VerticalLayout {
                        alignment: center;
                        StatusBlock { status: Home.status-of(row.badge); }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: row.family + " " + row.first;
                            color: Theme.text;
                            font-size: Theme.text-block-title;
                            font-weight: Theme.weight-block-title;
                            wrap: word-wrap;
                        }
                        SmallText { text: Results.by-course ? row.club + " · " + row.category : row.club; }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: end;
                            TimeText {
                                time: row.time;
                                crossed: row.crossed;
                                size: Theme.text-screen-title;
                                weight: Theme.weight-screen-title;
                                strike: Theme.time-strike-large;
                            }
                        }
                        if row.place-note != "": HorizontalLayout {
                            alignment: end;
                            SmallText { text: row.place-note; wrap: no-wrap; }
                        }
                    }
                }
            }
        }
    }
}

component ResultsContent {
    in property <LayoutMode> layout-mode;
    in property <length> available-width;

    property <bool> narrow: root.layout-mode == LayoutMode.narrow;
    property <bool> search-open: Results.search-text != "";

    Rectangle {
        background: Theme.card;
        border-radius: Theme.card-radius;
        border-width: Theme.card-outline-width;
        border-color: Theme.card-outline;
        clip: true;
        VerticalLayout {
            VerticalLayout {
                vertical-stretch: 0;
                padding: Theme.space;
                spacing: Theme.space-small;
                HorizontalLayout {
                    spacing: Theme.space;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        HorizontalLayout {
                            alignment: start;
                            spacing: Theme.space-small;
                            if Results.title-tone >= 0: VerticalLayout {
                                alignment: center;
                                CourseChip { tone: Results.title-tone; }
                            }
                            Text {
                                text: Results.title;
                                color: Theme.text;
                                font-size: Theme.text-body;
                                font-weight: Theme.weight-screen-title;
                                wrap: word-wrap;
                            }
                        }
                        SmallText { text: Results.state; }
                    }
                    // The filters, then the search (brief zones-onglets § 6).
                    if Results.filter-groups.length > 0: VerticalLayout {
                        alignment: start;
                        FilterButton {
                            filters: Results.active-filters;
                            narrow: root.narrow;
                            open: Courses.open-bubble == 27;
                            open-down: Courses.bubble-down;
                            clicked => {
                                Courses.open-at(27, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                            }
                            remove(g, c) => { Results.toggle-filter(g, c); }
                            clear => { Results.clear-filters(); }
                        }
                    }
                    if root.narrow: VerticalLayout {
                        alignment: start;
                        SearchToggle {
                            open: root.search-open;
                            clicked => {
                                if root.search-open {
                                    Results.search("");
                                }
                                root.search-open = !root.search-open;
                            }
                        }
                    }
                    if !root.narrow: VerticalLayout {
                        alignment: center;
                        InputField {
                            width: Theme.code-search-width;
                            placeholder: "Nom, club ou puce…";
                            text: Results.search-text;
                            edited(text) => { Results.search(text); }
                        }
                    }
                }
                // On a phone, the search unfolds smoothly under the head (Robin, 11/11).
                if root.narrow: Unfold {
                    open: root.search-open;
                    InputField {
                        // Opened, it takes the keyboard.
                        property <bool> wanted: root.search-open;
                        changed wanted => {
                            if self.wanted {
                                self.take-focus();
                            }
                        }
                        placeholder: "Nom, club ou puce…";
                        text: Results.search-text;
                        edited(text) => { Results.search(text); }
                    }
                }
            }
            RowLine { vertical-stretch: 0; }
            if root.narrow: ResultsList { }
            if !root.narrow: ResultsTable {
                vertical-stretch: 1;
                available-width: root.available-width;
            }
        }
    }
}

// The panel: the three views, the main one apart, then the figures that matter now.
component ResultsPanel inherits Sheet {
    property <int> shown: Participants.window-height >= Theme.panel-four-stats-height ? 4 : 2;

    VerticalLayout {
        padding: Theme.space;
        spacing: Theme.space-small;
        VerticalLayout {
          vertical-stretch: 0;
          spacing: Theme.space-small;
          for view[i] in Results.views: VerticalLayout {
            spacing: Theme.space-small;
            SetItem {
                main: i == 0;
                set: { name: view, count: "", detail: "" };
                active: Results.active-view == i;
                clicked => { Results.select-view(i); }
            }
            if i == 0: HorizontalLayout {
                padding: Theme.space-small;
                RowLine { }
            }
          }
        }
        Rectangle { vertical-stretch: 1; }
        for row in [0, 2]: HorizontalLayout {
            spacing: Theme.space;
            visible: row < root.shown && Results.stats.length > row;
            height: self.visible ? self.preferred-height : 0px;
            for n in [0, 1]: cell := Rectangle {
                horizontal-stretch: 1;
                min-height: tile.preferred-height;
                tile := StatTile {
                    visible: Results.stats.length > row + n;
                    width: cell.width;
                    block: Results.stats[row + n];
                    clicked => { Results.pick-stat(self.block.group, self.block.choice); }
                }
            }
        }
    }
}

// One row of a column: place, name, time, gap, state.
component ColumnRow inherits Rectangle {
    in property <ResultRow> entry;

    min-height: Theme.zone;
    background: root.entry.selected ? Theme.row-selected : zone.has-hover ? Theme.tab-hover : transparent;
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { Live.select-runner(root.entry.runner); }
    }
    HorizontalLayout {
        padding-left: Theme.space;
        padding-right: Theme.space;
        spacing: Theme.space;
        Text {
            width: Theme.column-place-width;
            text: root.entry.place;
            color: Theme.text;
            font-size: Theme.text-label;
            font-weight: Theme.weight-screen-title;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.entry.family + " " + root.entry.first;
                color: root.entry.crossed ? Theme.text-secondary : Theme.text;
                font-size: Theme.text-label;
                font-weight: Theme.weight-block-title;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            width: Theme.column-time-width;
            alignment: center;
            Text {
                text: root.entry.time;
                color: root.entry.crossed ? Theme.text-secondary : Theme.text;
                font-size: Theme.text-label;
                font-weight: Theme.weight-block-title;
                horizontal-alignment: right;
            }
            if root.entry.gap != "": Text {
                text: root.entry.gap;
                color: Theme.text-secondary;
                font-size: Theme.text-help;
                horizontal-alignment: right;
            }
        }
        if root.entry.place == "": VerticalLayout {
            alignment: center;
            StatusBadge { status: Home.status-of(root.entry.badge); }
        }
    }
}

// One ranking: its head stays at the top, its rows scroll under it.
component RankingCard inherits Sheet {
    in property <ResultColumn> column;

    clip: true;
    VerticalLayout {
        HorizontalLayout {
            padding: Theme.space;
            spacing: Theme.space;
            VerticalLayout {
                alignment: center;
                CourseChip { tone: root.column.tone; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.column.title;
                    color: Theme.text;
                    font-size: Theme.text-body;
                    font-weight: Theme.weight-screen-title;
                    wrap: word-wrap;
                }
                SmallText { text: root.column.state; }
            }
        }
        RowLine { }
        Flickable {
            vertical-stretch: 1;
            content-height: rows.preferred-height;
            rows := VerticalLayout {
                alignment: start;
                for row in root.column.rows: VerticalLayout {
                    ColumnRow { entry: row; }
                    RowLine { }
                }
            }
        }
    }
}

// The rankings side by side; they scroll sideways, with a bar at the bottom for the mouse
// (brief Cowork, 11/11: the only sideways scroll of the app). A row chosen, or found by the
// search, brings its column to the left, smoothly.
component ColumnsView {
    // The width given, not its own: its own would depend on the bar it shows.
    in property <length> available-width;
    property <length> step: Theme.result-column-width + Theme.space-medium;
    property <length> full: Results.columns.length * root.step - Theme.space-medium;
    property <length> room: max(0px, root.full - root.available-width);
    in-out property <length> shift: 0px;
    animate shift { duration: Theme.sheet-duration; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

    property <int> wanted: Results.focus-column;
    changed wanted => {
        if self.wanted >= 0 {
            root.shift = min(root.room, self.wanted * root.step);
        }
    }
    changed room => { root.shift = min(root.shift, root.room); }

    VerticalLayout {
        spacing: Theme.space;
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            // Behind the columns, so that their rows keep their clicks. The trackpad and the wheel with Shift: sideways.
            TouchArea {
                scroll-event(event) => {
                    if event.delta-x != 0 {
                        root.shift = max(0px, min(root.room, root.shift - event.delta-x));
                        return accept;
                    }
                    reject
                }
            }
            HorizontalLayout {
                x: -root.shift;
                width: root.full;
                spacing: Theme.space-medium;
                for column in Results.columns: RankingCard {
                    width: Theme.result-column-width;
                    column: column;
                }
            }
            if Results.columns.length == 0: Text {
                text: "Aucun classement";
                color: Theme.text-secondary;
                font-size: Theme.text-label;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        // The bar: its thumb shows what is seen, and can be dragged.
        if root.room > 0: track := Rectangle {
            height: Theme.scroll-bar-height;
            border-radius: self.height / 2;
            background: Theme.surface;
            thumb := Rectangle {
                x: root.shift / root.full * track.width;
                width: max(Theme.zone, root.available-width / root.full * track.width);
                height: parent.height;
                border-radius: self.height / 2;
                background: drag.has-hover || drag.pressed ? Theme.text-secondary : Theme.thin-outline;
            }
            drag := TouchArea {
                mouse-cursor: pointer;
                property <length> start-shift;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        self.start-shift = root.shift;
                    }
                }
                moved => {
                    root.shift = max(0px, min(root.room,
                        self.start-shift + (self.mouse-x - self.pressed-x) * root.full / track.width));
                }
                clicked => {
                    if self.mouse-x < thumb.x || self.mouse-x > thumb.x + thumb.width {
                        root.shift = max(0px, min(root.room, self.mouse-x / track.width * root.full - root.available-width / 2));
                    }
                }
            }
        }
    }
}

// The head of the card: no addition here; on the right, the filters and the search.
component ResultsHead inherits Sheet {
    height: self.preferred-height;
    HorizontalLayout {
        padding: Theme.space;
        spacing: Theme.space;
        Rectangle { horizontal-stretch: 1; }
        FilterButton {
            filters: Results.column-filters;
            open: Courses.open-bubble == 19;
            open-down: Courses.bubble-down;
            clicked => {
                Courses.open-at(19, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
            }
            remove(g, c) => { Results.toggle-column-filter(g, c); }
            clear => { Results.clear-column-filters(); }
        }
        VerticalLayout {
            alignment: center;
            InputField {
                width: Theme.code-search-width;
                placeholder: "Nom, club ou puce…";
                text: Results.search-text;
                edited(text) => { Results.search(text); }
            }
        }
    }
}

export component ResultsPage {
    in property <LayoutMode> layout-mode;
    in property <length> available-width;

    property <length> content-width: root.available-width - Theme.course-list-width - Theme.button-margin;

    VerticalLayout {
        if root.layout-mode == LayoutMode.narrow: VerticalLayout {
            spacing: Theme.button-margin;
            ChipFlow {
                items: Results.ranking-chips;
                active: Results.active-ranking;
                chip-width: Theme.live-reader-chip-width;
                clicked(i) => { Results.select-ranking(i); }
            }
            ResultsContent {
                layout-mode: root.layout-mode;
                available-width: root.available-width;
            }
        }
        if root.layout-mode != LayoutMode.narrow: Rectangle {
            HorizontalLayout {
                spacing: Theme.button-margin;
                // The panel; then the columns of the rankings, or the view chosen (brief Cowork, 11/11).
                ResultsPanel { width: Theme.course-list-width; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.space-medium;
                    if Results.active-view == 0: ResultsHead { vertical-stretch: 0; }
                    if Results.active-view == 0: ColumnsView {
                        vertical-stretch: 1;
                        available-width: root.content-width;
                    }
                    // Analyse and Remise des prix: to be designed later; their title only.
                    if Results.active-view != 0: Sheet {
                        vertical-stretch: 1;
                        Text {
                            text: Results.views[Results.active-view];
                            color: Theme.text-secondary;
                            font-size: Theme.text-body;
                            font-weight: Theme.weight-screen-title;
                        }
                    }
                }
            }
            SideDetail {
                width: parent.width;
                height: parent.height;
                shown: Live.detail-open;
                close => { Live.close-detail(); }
                LiveDetail { in-sheet: true; }
            }
        }
    }
}

// The rows of the Paramètres tab.
export component ResultsSettings {
    VerticalLayout {
        padding: Theme.space-medium;
        spacing: Theme.button-margin;
        HorizontalLayout {
            spacing: Theme.space;
            BubbleLabel { horizontal-stretch: 1; text: "Classer"; }
            // A setting, not a view (departs-tirage-v2.md § A).
            ChoiceSegments {
                choices: Results.modes;
                active: Results.active-mode;
                clicked(i) => { Results.select-mode(i); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space;
            BubbleLabel { horizontal-stretch: 1; text: "Temps maximal"; }
            BubbleLabel { text: "aucun"; wrap: no-wrap; }
        }
    }
}

export component ResultsBubble {
    in property <length> margin;

    BubbleFrame {
        width: 100%;
        height: 100%;
        margin: root.margin;
        wanted-width: Courses.open-bubble == 24 ? Theme.menu-bubble-width
            : Courses.open-bubble == 27 || Courses.open-bubble == 19 ? Theme.filter-bubble-width : Theme.bubble-width;
        // The « ⋯ » of a row (prototype: rDots): no effect yet.
        if Courses.open-bubble == 24: VerticalLayout {
            padding-top: Theme.space-small;
            padding-bottom: Theme.space-small;
            MenuItem { text: "Voir la fiche du coureur"; }
            MenuItem { text: "Arrivée manuelle…"; }
            MenuItem { text: "Changer le statut…"; }
            MenuItem { text: "Historique"; }
        }
        if Courses.open-bubble == 19: FiltersContent {
            groups: Results.column-filter-groups;
            toggle(g, c) => { Results.toggle-column-filter(g, c); }
            clear => { Results.clear-column-filters(); }
            close => { Courses.close-bubble(); }
        }
        if Courses.open-bubble == 27: FiltersContent {
            groups: Results.filter-groups;
            toggle(g, c) => { Results.toggle-filter(g, c); }
            clear => { Results.clear-filters(); }
            close => { Courses.close-bubble(); }
        }
    }
}
