// The Coureurs et clubs page, following coureurs-clubs.md and mise-en-page-universelle.md: no
// column, the local base in one table, and the detail of a runner.

import { Theme } from "../theme.slint";
import { LayoutMode } from "../navigation.slint";
import { InputField } from "../components/field.slint";
import { Icons } from "../components/icons.slint";
import { ActiveFilter, BottomDetail, FilterButton, FilterGroup, FiltersContent, SideDetail, Unfold, Sheet } from "../components/zones.slint";
import { PrimaryButton, RowButton, SecondaryButton } from "../components/buttons.slint";
import { Tabs } from "../components/tabs.slint";
import { StatusBadge } from "../components/status.slint";
import { BadgeKind, Home } from "home.slint";
import { AlertPill, BubbleFrame, BubbleLabel, Courses, RowLine, SearchToggle, SmallText } from "courses.slint";
import { Cell, PanelSet, SetItem, StatBlock, StatsRows, Title } from "participants.slint";
import { ChipFlow, Head, LiveFilter, RowCell } from "live.slint";
import { DetailLine, DetailTitle } from "cards.slint";

export struct BaseRunnerRow {
    id: int,
    family: string,
    first: string,
    club: string,
    league: string,
    category: string,
    year: string,
    licence: string,
    kind: string,
    card: string,
    points: string,
    duplicate: bool,    // looks like another record (Robin, 12/11)
    selected: bool,
}

// A club, in the Clubs sub-tab.
export struct ClubLine {
    name: string,
    league: string,
    number: string,
    runners: string,
    twin: string,       // « Même club que … ? », or empty
}

export struct BaseIssue {
    id: int,
    label: string,
    detail: string,
}

export global RunnerBase {
    in property <[BaseRunnerRow]> rows;
    in property <bool> clubs-tab;             // the panel: Coureurs or Clubs (Robin, 12/11)
    in property <PanelSet> main-set;
    in property <string> sets-title;          // Origine, Ligues
    in property <[PanelSet]> sets;
    in property <int> active-set: -1;
    in property <[StatBlock]> stats;
    in property <[ClubLine]> club-rows;
    callback select-tab(bool);
    callback select-set(int);
    callback pick-stat(int, int);
    callback show-club(string);
    in property <[LiveFilter]> filters;
    in property <int> active-filter;
    in property <[FilterGroup]> filter-groups;
    in property <[ActiveFilter]> active-filters;
    callback toggle-filter(int, int);
    callback clear-filters();
    in property <int> sort-column;
    in property <bool> sort-ascending: true;
    in property <string> title;
    in property <string> state;
    in property <string> empty;
    in property <string> summary;
    in property <string> summary-short;
    in property <string> search-text;
    in property <string> alert-title;
    in property <string> alert-count;
    in property <[BaseIssue]> duplicates;
    in property <string> duplicates-title;
    in property <[BaseIssue]> shared-cards;
    in property <string> shared-cards-title;

    in property <bool> detail-open;
    in property <string> detail-name;
    in property <string> detail-subtitle;
    in property <string> detail-kind;
    in property <string> detail-club;
    in property <string> detail-code;
    in property <string> detail-league;
    in property <bool> detail-has-licence;
    in property <string> detail-licence;
    in property <string> detail-licence-kind;
    in property <string> detail-season;
    in property <bool> detail-not-renewed;
    in property <string> detail-points;
    in property <string> detail-sex;
    in property <string> detail-year;
    in property <string> detail-category;
    in property <string> detail-card;
    in property <string> detail-shared;
    in property <string> detail-loan;
    in property <string> detail-origin;
    in property <bool> confirming;

    callback select-filter(int);
    callback select-row(int);
    callback open-runner(int);
    callback sort-by(int);
    callback search(string);
    callback close-detail();
    callback ask-delete();
    callback cancel-delete();
    callback confirm-delete();
}

// The titles stay at the top: only the rows scroll. Columns leave rather than scroll sideways.
component RunnerBaseTable {
    in property <length> available-width;

    property <bool> full: root.available-width >= Theme.base-full-width;
    // Ligue and Points CN are in the runner's detail (Robin, 12/11); the last column holds the
    // « Doublon ? » mark and its button.
    // A narrow table (iPad portrait) keeps the name, the club, the category and the button:
    // the type and the card are in the detail.
    property <length> duplicate-width: root.full ? Theme.base-duplicate-width : Theme.base-duplicate-narrow-width;
    property <length> fixed: Theme.base-club-width + Theme.base-category-width + root.duplicate-width
        + (root.full ? Theme.base-first-width + Theme.base-year-width + Theme.base-licence-width + Theme.base-kind-width + Theme.base-card-width : 0px);
    property <length> name-width: root.available-width - root.fixed;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 0;
            height: Theme.table-header-height + Theme.space;
            Title { width: root.name-width; label: "Nom"; sorted: RunnerBase.sort-column == 0; ascending: RunnerBase.sort-ascending; clicked => { RunnerBase.sort-by(0); } }
            if root.full: Title { width: Theme.base-first-width; label: "Prénom"; sorted: RunnerBase.sort-column == 1; ascending: RunnerBase.sort-ascending; clicked => { RunnerBase.sort-by(1); } }
            Title { width: Theme.base-club-width; label: "Club"; sorted: RunnerBase.sort-column == 2; ascending: RunnerBase.sort-ascending; clicked => { RunnerBase.sort-by(2); } }
            Title { width: Theme.base-category-width; label: "Cat."; sorted: RunnerBase.sort-column == 4; ascending: RunnerBase.sort-ascending; clicked => { RunnerBase.sort-by(4); } }
            if root.full: Title { width: Theme.base-year-width; label: "Année"; sorted: RunnerBase.sort-column == 5; ascending: RunnerBase.sort-ascending; clicked => { RunnerBase.sort-by(5); } }
            if root.full: Title { width: Theme.base-licence-width; label: "Licence"; sorted: RunnerBase.sort-column == 6; ascending: RunnerBase.sort-ascending; clicked => { RunnerBase.sort-by(6); } }
            if root.full: Title { width: Theme.base-kind-width; label: "Type"; sorted: RunnerBase.sort-column == 7; ascending: RunnerBase.sort-ascending; clicked => { RunnerBase.sort-by(7); } }
            if root.full: Title { width: Theme.base-card-width; label: "Puce"; sorted: RunnerBase.sort-column == 8; ascending: RunnerBase.sort-ascending; clicked => { RunnerBase.sort-by(8); } }
            Rectangle { width: root.duplicate-width; }
        }
        RowLine { vertical-stretch: 0; }
        if RunnerBase.empty != "": Text {
            vertical-stretch: 1;
            text: RunnerBase.empty;
            color: Theme.text-secondary;
            font-size: Theme.text-label;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if RunnerBase.empty == "": Flickable {
            vertical-stretch: 1;
            content-height: lines.preferred-height;
            lines := VerticalLayout {
                width: root.available-width;
                alignment: start;
                for row[n] in RunnerBase.rows: VerticalLayout {
                    if n > 0: RowLine { }
                    Rectangle {
                        min-height: Theme.zone;
                        background: row.selected ? Theme.row-selected : row.duplicate ? Theme.row-to-check : transparent;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { RunnerBase.select-row(row.id); }
                        }
                        HorizontalLayout {
                            HorizontalLayout {
                                width: root.name-width;
                                padding-left: Theme.space;
                                alignment: start;
                                spacing: Theme.space-small;
                                Cell { text: row.family; font-weight: Theme.weight-screen-title; }
                                if !root.full: Cell { text: row.first; }
                            }
                            if root.full: RowCell { width: Theme.base-first-width; Cell { text: row.first; } }
                            HorizontalLayout {
                                width: Theme.base-club-width;
                                padding-left: Theme.space;
                                Cell { text: row.club; wrap: word-wrap; }
                            }
                            RowCell { width: Theme.base-category-width; Cell { text: row.category; } }
                            if root.full: RowCell { width: Theme.base-year-width; Cell { text: row.year; } }
                            if root.full: RowCell { width: Theme.base-licence-width; Cell { text: row.licence; } }
                            if root.full: RowCell { width: Theme.base-kind-width; Cell { text: row.kind; } }
                            if root.full: RowCell { width: Theme.base-card-width; Cell { text: row.card; } }
                            HorizontalLayout {
                                width: root.duplicate-width;
                                padding-right: Theme.space;
                                spacing: Theme.space;
                                alignment: end;
                                if row.duplicate && root.full: VerticalLayout { alignment: center; StatusBadge { status: Home.status-of({ word: "Doublon ?", kind: BadgeKind.to-check }); } }
                                if row.duplicate: RowButton { label: "Comparer"; }
                            }
                        }
                    }
                }
            }
        }
    }
}

// On a phone: who › the club and the category › the card.
component RunnerBaseList {
    VerticalLayout {
        if RunnerBase.empty != "": Text {
            height: Theme.live-card-narrow-height;
            text: RunnerBase.empty;
            color: Theme.text-secondary;
            font-size: Theme.text-label;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        for row[n] in RunnerBase.rows: VerticalLayout {
            if n > 0: RowLine { }
            Rectangle {
                min-height: Theme.zone;
                background: row.selected ? Theme.row-selected : transparent;
                TouchArea {
                    clicked => { RunnerBase.select-row(row.id); }
                }
                HorizontalLayout {
                    padding: Theme.space;
                    spacing: Theme.space;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: row.family + " " + row.first;
                            color: Theme.text;
                            font-size: Theme.text-help;
                            font-weight: Theme.weight-screen-title;
                            wrap: word-wrap;
                        }
                        SmallText { text: row.club + " · " + row.category; }
                    }
                    VerticalLayout {
                        alignment: center;
                        SmallText { text: row.card; wrap: no-wrap; }
                    }
                }
            }
        }
    }
}

// The clubs: league, FFCO number, runners; a club that looks like another is to merge
// (Robin, 12/11); the others lead to their runners.
component ClubsLines {
    VerticalLayout {
        HorizontalLayout {
            height: Theme.table-header-height + Theme.space;
            Title { horizontal-stretch: 1; label: "Club"; }
            Title { width: Theme.base-league-width; label: "Ligue"; }
            Title { width: Theme.base-licence-width; label: "N° FFCO"; }
            Title { width: Theme.base-licence-width; label: "Coureurs"; }
            Rectangle { width: Theme.base-club-action-width; }
        }
        RowLine { }
        Flickable {
            vertical-stretch: 1;
            content-height: lines.preferred-height;
            lines := VerticalLayout {
                alignment: start;
                for club in RunnerBase.club-rows: VerticalLayout {
                    Rectangle {
                        min-height: Theme.zone;
                        background: club.twin != "" ? Theme.row-to-check : transparent;
                        HorizontalLayout {
                            HorizontalLayout { horizontal-stretch: 1; padding-left: Theme.space; Cell { text: club.name; font-weight: Theme.weight-screen-title; } }
                            RowCell { width: Theme.base-league-width; Cell { text: club.league; } }
                            RowCell { width: Theme.base-licence-width; Cell { text: club.number; } }
                            RowCell { width: Theme.base-licence-width; Cell { text: club.runners; } }
                            HorizontalLayout {
                                width: Theme.base-club-action-width;
                                padding-right: Theme.space;
                                spacing: Theme.space;
                                alignment: end;
                                if club.twin != "": VerticalLayout { alignment: center; StatusBadge { status: Home.status-of({ word: club.twin, kind: BadgeKind.to-check }); } }
                                if club.twin != "": RowButton { label: "Fusionner"; }
                                if club.twin == "": RowButton {
                                    go: true;
                                    label: "Voir ses coureurs ›";
                                    clicked => { RunnerBase.show-club(club.name); }
                                }
                            }
                        }
                    }
                    RowLine { }
                }
            }
        }
    }
}

// The panel (Robin, 12/11): Coureurs / Clubs as sub-tabs, the main choice apart, a sub-zone
// (Origine, Ligues), then the figures.
component RunnerBasePanel inherits Sheet {
    VerticalLayout {
        padding: Theme.space;
        spacing: Theme.space-small;
        Tabs {
            tabs: [{ label: "Coureurs" }, { label: "Clubs" }];
            active: RunnerBase.clubs-tab ? 1 : 0;
            clicked(i) => { RunnerBase.select-tab(i == 1); }
        }
        Rectangle { height: Theme.space-small; }
        SetItem {
            main: true;
            set: RunnerBase.main-set;
            active: RunnerBase.active-set < 0;
            clicked => { RunnerBase.select-set(-1); }
        }
        HorizontalLayout {
            padding: Theme.space-small;
            RowLine { }
        }
        Text {
            text: RunnerBase.sets-title;
            color: Theme.text-secondary;
            font-size: Theme.text-help;
            font-weight: Theme.weight-block-title;
        }
        for set[i] in RunnerBase.sets: SetItem {
            set: set;
            active: RunnerBase.active-set == i;
            clicked => { RunnerBase.select-set(i); }
        }
        Rectangle { vertical-stretch: 1; }
        StatsRows {
            stats: RunnerBase.stats;
            picked(g, c) => { RunnerBase.pick-stat(g, c); }
        }
    }
}

component RunnerBaseContent {
    in property <LayoutMode> layout-mode;
    in property <length> available-width;

    property <bool> narrow: root.layout-mode == LayoutMode.narrow;
    property <bool> search-open: RunnerBase.search-text != "";
    // A narrow card (iPad portrait): the title under the buttons, the search on its own row.
    property <bool> stacked: !root.narrow && root.available-width < Theme.club-head-stacked;

    VerticalLayout {
        spacing: root.narrow ? Theme.button-margin : Theme.space;
        // A phone: the head and the list in one card. Wider: the head is a band of its own,
        // over the card of the table (brief Cowork, 11/11).
        Rectangle {
            vertical-stretch: root.narrow ? 0 : 1;
            background: root.narrow ? Theme.card : transparent;
            border-radius: Theme.card-radius;
            border-width: root.narrow ? Theme.card-outline-width : 0px;
            border-color: Theme.card-outline;
            clip: false;
            VerticalLayout {
                spacing: root.narrow ? 0px : Theme.space-medium;
                Rectangle {
                vertical-stretch: 0;
                background: root.narrow ? transparent : Theme.card;
                border-radius: Theme.sheet-radius;
                border-width: root.narrow ? 0px : Theme.card-outline-width;
                border-color: Theme.card-outline;
                drop-shadow-blur: root.narrow ? 0px : Theme.sheet-shadow-blur;
                drop-shadow-offset-y: root.narrow ? 0px : Theme.sheet-shadow-offset;
                drop-shadow-color: Theme.sheet-shadow;
                VerticalLayout {
                    vertical-stretch: 0;
                    padding: Theme.space;
                    spacing: Theme.space-small;
                    // The add action in orange; on the right, the alert, the filters and the search
                    // (brief zones-onglets § 6).
                    HorizontalLayout {
                        spacing: Theme.space;
                        PrimaryButton {
                            label: root.narrow || root.stacked ? "Ajouter" : RunnerBase.clubs-tab ? "Ajouter un club" : "Ajouter un coureur";
                            icon: Icons.plus;
                            has-icon: true;
                        }
                        // What we add, next to it, by the sub-tab (Robin, 12/11).
                        if !root.narrow && !RunnerBase.clubs-tab: SecondaryButton { label: "Importer FFCO…"; }
                        if !root.narrow && RunnerBase.clubs-tab: SecondaryButton { label: "Fusionner des clubs…"; }
                        if !root.narrow && !root.stacked: VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: RunnerBase.title;
                                color: Theme.text;
                                font-size: Theme.text-body;
                                font-weight: Theme.weight-screen-title;
                                wrap: word-wrap;
                            }
                            SmallText { text: RunnerBase.state; }
                        }
                        if root.narrow || root.stacked: Rectangle { horizontal-stretch: 1; }
                        if RunnerBase.alert-title != "": VerticalLayout {
                            alignment: center;
                            AlertPill {
                                title: RunnerBase.alert-title;
                                count: RunnerBase.alert-count;
                                bubble: 20;
                                compact: root.narrow || root.stacked;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            FilterButton {
                                filters: RunnerBase.active-filters;
                                narrow: root.narrow;
                                open: Courses.open-bubble == 30;
                                open-down: Courses.bubble-down;
                                clicked => {
                                    Courses.open-at(30, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                                }
                                remove(g, c) => { RunnerBase.toggle-filter(g, c); }
                                clear => { RunnerBase.clear-filters(); }
                            }
                        }
                        if root.narrow: VerticalLayout {
                            alignment: start;
                            SearchToggle {
                                open: root.search-open;
                                clicked => {
                                    if root.search-open {
                                        RunnerBase.search("");
                                    }
                                    root.search-open = !root.search-open;
                                }
                            }
                        }
                        if !root.narrow && !root.stacked: VerticalLayout {
                            alignment: center;
                            InputField {
                                width: Theme.code-search-width;
                                placeholder: "Nom, club, licence ou puce…";
                                text: RunnerBase.search-text;
                                edited(text) => { RunnerBase.search(text); }
                            }
                        }
                    }
                    // A phone or a narrow card: the title under the buttons, which keep the width.
                    if root.narrow || root.stacked: VerticalLayout {
                        Text {
                            text: RunnerBase.title;
                            color: Theme.text;
                            font-size: Theme.text-body;
                            font-weight: Theme.weight-screen-title;
                            wrap: word-wrap;
                        }
                        SmallText { text: RunnerBase.state; }
                    }
                    if root.stacked: InputField {
                        placeholder: "Nom, club, licence ou puce…";
                        text: RunnerBase.search-text;
                        edited(text) => { RunnerBase.search(text); }
                    }
                    // On a phone, the search unfolds smoothly under the head (Robin, 11/11).
                    if root.narrow: Unfold {
                        open: root.search-open;
                        InputField {
                            // Opened, it takes the keyboard.
                            property <bool> wanted: root.search-open;
                            changed wanted => {
                                if self.wanted {
                                    self.take-focus();
                                }
                            }
                            placeholder: "Nom, club, licence ou puce…";
                            text: RunnerBase.search-text;
                            edited(text) => { RunnerBase.search(text); }
                        }
                    }
                }
                }
                if root.narrow: RowLine { vertical-stretch: 0; }
                if root.narrow: RunnerBaseList { }
                if !root.narrow && RunnerBase.clubs-tab: Sheet {
                    vertical-stretch: 1;
                    clip: true;
                    ClubsLines {
                        width: parent.width;
                        height: parent.height;
                    }
                }
                if !root.narrow && !RunnerBase.clubs-tab: Sheet {
                    vertical-stretch: 1;
                    clip: true;
                    RunnerBaseTable {
                        width: parent.width;
                        height: parent.height;
                        available-width: root.available-width;
                    }
                }
            }
        }
    }
}

export component BaseRunnerDetail inherits Rectangle {
    in property <bool> in-sheet;   // inside the side or bottom panel: no frame of its own

    background: root.in-sheet ? transparent : Theme.card;
    border-radius: Theme.card-radius;
    border-width: root.in-sheet ? 0px : Theme.thin-outline-width;
    border-color: Theme.thin-outline;

    // Behind the content, so that a click in the detail does not close it.
    TouchArea { }

    VerticalLayout {
        padding: Theme.space-medium;
        spacing: Theme.button-margin;
        alignment: start;
        HorizontalLayout {
            spacing: Theme.space;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Theme.space-small;
                Text {
                    text: RunnerBase.detail-name;
                    color: Theme.text;
                    font-size: Theme.text-body;
                    font-weight: Theme.weight-screen-title;
                    wrap: word-wrap;
                }
                SmallText { text: RunnerBase.detail-subtitle; }
                if RunnerBase.detail-kind != "": HorizontalLayout {
                    alignment: start;
                    StatusBadge { status: Home.status-of({ word: RunnerBase.detail-kind, kind: inactive }); }
                }
            }
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: Theme.zone;
                    height: Theme.zone;
                    accessible-role: button;
                    accessible-label: "Fermer";
                    Image {
                        source: Icons.x;
                        colorize: Theme.text-secondary;
                        width: Theme.button-icon;
                        height: Theme.button-icon;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { RunnerBase.close-detail(); }
                    }
                }
            }
        }

        DetailTitle { text: "Club"; }
        BubbleLabel { text: RunnerBase.detail-club; }
        DetailLine { label: "Code"; value: RunnerBase.detail-code; }
        VerticalLayout {
            SmallText { text: "Ligue"; }
            BubbleLabel { text: RunnerBase.detail-league; }
        }

        RowLine { }
        DetailTitle { text: "Licence FFCO"; }
        if RunnerBase.detail-has-licence: DetailLine { label: "N°"; value: RunnerBase.detail-licence; }
        if RunnerBase.detail-has-licence: DetailLine { label: "Type"; value: RunnerBase.detail-licence-kind; }
        if RunnerBase.detail-has-licence: VerticalLayout {
            SmallText { text: "Saison"; }
            Text {
                text: RunnerBase.detail-season;
                color: RunnerBase.detail-not-renewed ? Theme.to-check.badge-text : Theme.text;
                font-size: Theme.text-help;
                wrap: word-wrap;
            }
        }
        if RunnerBase.detail-has-licence: DetailLine { label: "Points CN"; value: RunnerBase.detail-points; }
        if !RunnerBase.detail-has-licence: HorizontalLayout {
            alignment: start;
            StatusBadge { status: Home.status-of({ word: RunnerBase.detail-licence-kind, kind: to-check }); }
        }
        if !RunnerBase.detail-has-licence: SmallText { text: "Fiche saisie à la main."; }
        if !RunnerBase.detail-has-licence: HorizontalLayout { alignment: start; SecondaryButton { label: "Chercher le licencié…"; } }

        RowLine { }
        DetailTitle { text: "Coureur"; }
        DetailLine { label: "Sexe"; value: RunnerBase.detail-sex; }
        DetailLine { label: "Année"; value: RunnerBase.detail-year; }
        DetailLine { label: "Catégorie"; value: RunnerBase.detail-category; }
        DetailLine { label: "Puce"; value: RunnerBase.detail-card; }
        if RunnerBase.detail-shared != "": Text {
            text: RunnerBase.detail-shared;
            color: Theme.to-check.badge-text;
            font-size: Theme.text-help;
            wrap: word-wrap;
        }
        if RunnerBase.detail-loan != "": Text {
            text: RunnerBase.detail-loan;
            color: Theme.to-check.badge-text;
            font-size: Theme.text-help;
            wrap: word-wrap;
        }

        RowLine { }
        SmallText { text: RunnerBase.detail-origin; }
        if !RunnerBase.confirming: HorizontalLayout { alignment: start; SecondaryButton { label: "Modifier…"; } }
        if !RunnerBase.confirming: HorizontalLayout {
            alignment: start;
            SecondaryButton {
                label: "Supprimer…";
                danger: true;
                clicked => { RunnerBase.ask-delete(); }
            }
        }
        if RunnerBase.confirming: BubbleLabel { text: "Supprimer cette fiche de la base ?"; }
        if RunnerBase.confirming: HorizontalLayout {
            alignment: start;
            spacing: Theme.space;
            SecondaryButton {
                label: "Annuler";
                clicked => { RunnerBase.cancel-delete(); }
            }
            SecondaryButton {
                label: "Supprimer";
                danger: true;
                clicked => { RunnerBase.confirm-delete(); }
            }
        }
    }
}

export component RunnerBasePage {
    in property <LayoutMode> layout-mode;
    in property <length> available-width;

    VerticalLayout {
        if root.layout-mode == LayoutMode.narrow: RunnerBaseContent {
            layout-mode: root.layout-mode;
            available-width: root.available-width;
        }
        if root.layout-mode != LayoutMode.narrow: Rectangle {
            HorizontalLayout {
                spacing: Theme.button-margin;
                RunnerBasePanel { width: Theme.course-list-width; }
                RunnerBaseContent {
                    horizontal-stretch: 1;
                    layout-mode: root.layout-mode;
                    available-width: root.available-width - Theme.course-list-width - Theme.button-margin;
                }
            }
            SideDetail {
                width: parent.width;
                height: parent.height;
                shown: RunnerBase.detail-open;
                close => { RunnerBase.close-detail(); }
                BaseRunnerDetail { in-sheet: true; }
            }
        }
    }
}

// On a phone, the detail rises from the bottom.
export component BaseRunnerOverlay {
    BottomDetail {
        width: root.width;
        height: root.height;
        shown: RunnerBase.detail-open;
        close => { RunnerBase.close-detail(); }
        BaseRunnerDetail { in-sheet: true; }
    }
}

// One line per point to check, each with its button.
component IssueLine {
    in property <BaseIssue> issue;

    HorizontalLayout {
        spacing: Theme.space;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            BubbleLabel { text: root.issue.label; }
            SmallText { text: root.issue.detail; }
        }
        VerticalLayout {
            alignment: center;
            // A look, not the screen's action: secondary (one orange button per screen).
            SecondaryButton {
                label: "Voir";
                clicked => {
                    Courses.close-bubble();
                    RunnerBase.open-runner(root.issue.id);
                }
            }
        }
    }
}

component IssueGroupTitle inherits Text {
    color: Theme.text;
    font-size: Theme.text-help;
    font-weight: Theme.weight-block-title;
    wrap: word-wrap;
}

// The two checks of coureurs-clubs.md § 7, each under its own title.
component IssuesContent {
    VerticalLayout {
        padding: Theme.space-medium;
        spacing: Theme.space;
        Text {
            text: RunnerBase.alert-title;
            color: Theme.text;
            font-size: Theme.text-label;
            font-weight: Theme.weight-screen-title;
            wrap: word-wrap;
        }
        if RunnerBase.duplicates.length > 0: IssueGroupTitle { text: RunnerBase.duplicates-title; }
        for issue in RunnerBase.duplicates: IssueLine { issue: issue; }
        if RunnerBase.duplicates.length > 0 && RunnerBase.shared-cards.length > 0: RowLine { }
        if RunnerBase.shared-cards.length > 0: IssueGroupTitle { text: RunnerBase.shared-cards-title; }
        for issue in RunnerBase.shared-cards: IssueLine { issue: issue; }
        SmallText { text: "Rien n'est changé sans votre accord"; }
    }
}

export component RunnerBaseBubble {
    in property <length> margin;

    BubbleFrame {
        width: 100%;
        height: 100%;
        margin: root.margin;
        wanted-width: Courses.open-bubble == 30 ? Theme.filter-bubble-width : Theme.bubble-width;
        if Courses.open-bubble == 20: IssuesContent { }
        if Courses.open-bubble == 30: FiltersContent {
            groups: RunnerBase.filter-groups;
            toggle(g, c) => { RunnerBase.toggle-filter(g, c); }
            clear => { RunnerBase.clear-filters(); }
            close => { Courses.close-bubble(); }
        }
    }
}
