// The Circuits tab, following 03-circuits-tous-les-postes.png. Rust gives the rows,
// already sorted and filtered; this file shows them and sends the clicks back.

import { Theme } from "../theme.slint";
import { LayoutMode } from "../navigation.slint";
import { Icons } from "../components/icons.slint";
import { InputField } from "../components/field.slint";
import { PrimaryButton, SecondaryButton } from "../components/buttons.slint";
import { Tabs, TabItem } from "../components/tabs.slint";

export struct CourseItem {
    index: int,
    name: string,
    summary: string,
    trace: string,
}

export struct ColumnTitle {
    name: string,
    tone: int,
}

export struct ControlRow {
    code: string,
    unused: bool,
    shared: bool,
    selected: bool,
    ranks: [int],
    usage: string,
    usage-short: string,
}

export struct SequenceStop {
    code: string,
    rank: int,
    selected: bool,
}

export struct CourseLine {
    name: string,
    tone: int,
    count: string,
    dimmed: bool,
    stops: [SequenceStop],
}

export struct MapMarker {
    code: string,
    x: float,
    y: float,
    unused: bool,
    selected: bool,
    dimmed: bool,
}

export struct DetailCourse {
    name: string,
    tone: int,
    rank: string,
    before: string,
    after: string,
}

export global Courses {
    in property <bool> empty;
    in property <bool> course-selected;     // one course chosen: the rest of this page is about it
    in property <bool> list-only;           // on a phone: nothing chosen yet
    in property <string> course-title;
    in property <string> code-search-text;
    in property <string> course-search-text;
    in property <[CourseItem]> items;
    in property <string> all-summary;
    in property <string> all-trace;

    in property <[string]> chips;
    in property <string> alert-title;
    in property <string> alert-count;
    in property <string> alert-detail;
    in property <string> summary;

    in property <[TabItem]> views;
    in property <[TabItem]> views-narrow;
    in property <int> active-view;
    in property <[TabItem]> highlights;
    in property <int> active-highlight;
    in property <int> active-course: -1;

    in property <string> all-courses-usage;
    in property <[ColumnTitle]> columns;
    in property <int> sort-column: -1;      // -1 code, -2 usage, otherwise a course
    in property <bool> sort-ascending: true;
    in property <[ControlRow]> rows;
    in property <[CourseLine]> lines;
    in property <[string]> unused-codes;
    in property <[string]> traces;
    in property <[MapMarker]> markers;
    in property <float> start-x;
    in property <float> start-y;
    in property <float> finish-x;
    in property <float> finish-y;

    in property <bool> detail-open;
    in property <string> detail-code;
    in property <string> detail-subtitle;
    in property <[DetailCourse]> detail-courses;
    in property <string> detail-entrants;

    // The open bubble is only a display matter: 0 none, 1 settings, 2 alert.
    in-out property <int> open-bubble;
    in-out property <length> bubble-left;
    in-out property <length> bubble-right;
    in-out property <length> bubble-top;

    callback select-course(int);            // -1 all controls, -2 back to the list
    callback select-view(int);
    callback select-highlight(int);
    callback sort-by(int);
    callback select-control(string);
    callback close-detail();
    callback code-search(string);
    callback course-search(string);

    public pure function tone-color(tone: int) -> color {
        if tone == 0 { return Theme.course-blue; }
        if tone == 1 { return Theme.course-red; }
        if tone == 2 { return Theme.course-green; }
        if tone == 3 { return Theme.course-violet; }
        return Theme.course-yellow;
    }

    public pure function mark-color(tone: int) -> color {
        return tone == 4 ? Theme.course-yellow-mark : tone-color(tone);
    }

    public pure function is-dimmed(column: int) -> bool {
        return active-highlight > 0 && active-highlight - 1 != column;
    }
}

component CourseChip inherits Rectangle {
    in property <int> tone;

    width: Theme.course-chip;
    height: Theme.course-chip;
    border-radius: Theme.course-chip-radius;
    background: Courses.tone-color(root.tone);
}

component ControlTag {
    callback clicked();
    in property <string> code;
    in property <bool> unused;
    in property <bool> selected;

    min-width: max(Theme.tag-min-width, label.preferred-width + 2 * Theme.space-small);
    height: Theme.tag-height;
    Rectangle {
        border-radius: Theme.tag-radius;
        border-width: Theme.tag-outline;
        border-color: root.unused ? Theme.tag-unused : Theme.purple;
        background: root.selected ? Theme.tag-selected-background : Theme.tag-background;
    }
    label := Text {
        text: root.code;
        color: root.unused ? Theme.tag-unused : Theme.purple;
        font-size: Theme.text-help;
        font-weight: Theme.weight-screen-title;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component RankDot {
    in property <int> rank;
    in property <int> tone;

    width: Theme.rank-size;
    height: Theme.rank-size;
    if root.rank > 0: Rectangle {
        border-radius: self.width / 2;
        border-width: Theme.tag-outline;
        border-color: Courses.tone-color(root.tone);
        background: Theme.tag-background;
        Text {
            text: root.rank;
            color: Theme.rank-text;
            font-size: Theme.text-help;
            font-weight: Theme.weight-screen-title;
        }
    }
    if root.rank <= 0: Rectangle {
        width: Theme.no-rank-dot;
        height: Theme.no-rank-dot;
        border-radius: self.width / 2;
        background: Theme.thin-outline;
    }
}

component SmallText inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.text-help;
    wrap: word-wrap;
}

component MiniMap inherits Rectangle {
    in property <string> trace;

    width: Theme.mini-map-width;
    height: Theme.mini-map-height;
    border-radius: Theme.tag-radius;
    clip: true;
    Image {
        source: @image-url("../map/course-map.svg");
        width: 100%;
        height: 100%;
        image-fit: fill;
    }
    if root.trace != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 600;
        viewbox-height: 360;
        commands: root.trace;
        stroke: Theme.purple;
        stroke-width: Theme.thin-outline-width;
    }
}

component CourseListItem inherits Rectangle {
    callback clicked();
    in property <string> name;
    in property <string> summary;
    in property <string> trace;
    in property <bool> active;
    in property <int> tone: -1;

    border-radius: Theme.field-radius;
    background: root.active ? Theme.active-tab-background : zone.has-hover ? Theme.tab-hover : transparent;

    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: Theme.space;
        spacing: Theme.space;
        min-height: Theme.zone;
        VerticalLayout {
            alignment: center;
            MiniMap { trace: root.trace; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            HorizontalLayout {
                spacing: Theme.space-small;
                if root.tone >= 0: VerticalLayout {
                    alignment: center;
                    CourseChip { tone: root.tone; }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.name;
                    color: root.active ? Theme.active-tab-text : Theme.text;
                    font-size: Theme.text-help;
                    font-weight: Theme.weight-screen-title;
                    wrap: word-wrap;
                }
            }
            Text {
                text: root.summary;
                color: root.active ? Theme.active-tab-text : Theme.text-secondary;
                font-size: Theme.text-help;
                wrap: word-wrap;
            }
        }
    }
}

// A magnifier that unfolds a search field below it, and closes it again.
component SearchToggle inherits Rectangle {
    callback clicked();
    in property <bool> open;

    width: Theme.zone;
    height: Theme.zone;
    accessible-role: button;
    accessible-label: root.open ? "Fermer la recherche" : "Chercher";
    accessible-action-default => { root.clicked(); }
    Rectangle {
        width: Theme.secondary-button-height;
        height: Theme.secondary-button-height;
        border-radius: Theme.secondary-button-radius;
        border-width: Theme.thin-outline-width;
        border-color: Theme.thin-outline;
        background: zone.pressed ? Theme.secondary-button-pressed
            : zone.has-hover ? Theme.secondary-button-hover
            : Theme.secondary-button;
        animate background { duration: Theme.tint-duration; }
        Image {
            source: root.open ? Icons.x : Icons.search;
            colorize: Theme.text;
            width: Theme.button-icon;
            height: Theme.button-icon;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component CourseRows {
    in property <bool> narrow;

    VerticalLayout {
        alignment: start;
        CourseListItem {
            name: "Tous les postes";
            summary: Courses.all-summary;
            trace: Courses.all-trace;
            active: Courses.active-course < 0 && !(root.narrow && Courses.list-only);
            clicked => { Courses.select-course(-1); }
        }
        for item in Courses.items: CourseListItem {
            name: item.name;
            summary: item.summary;
            trace: item.trace;
            tone: item.index;
            active: Courses.active-course == item.index;
            clicked => { Courses.select-course(item.index); }
        }
    }
}

// `narrow`: the list is the page, which scrolls. Otherwise the column is a card of fixed
// height, whose list scrolls on its own.
export component CourseList inherits Rectangle {
    in property <bool> narrow;

    property <bool> search-open: Courses.course-search-text != "";

    background: root.narrow ? transparent : Theme.card;
    border-radius: root.narrow ? 0 : Theme.card-radius;
    border-width: root.narrow ? 0 : Theme.card-outline-width;
    border-color: Theme.card-outline;

    VerticalLayout {
        padding: root.narrow ? 0 : Theme.space;
        spacing: Theme.space;
        HorizontalLayout {
            spacing: Theme.space;
            SecondaryButton { label: "Importer"; }
            SecondaryButton {
                label: "Nouveau";
                icon: Icons.plus;
                has-icon: true;
            }
            Rectangle { horizontal-stretch: 1; }
            SearchToggle {
                open: root.search-open;
                clicked => {
                    if root.search-open {
                        Courses.course-search("");
                    }
                    root.search-open = !root.search-open;
                }
            }
        }
        if root.search-open: InputField {
            placeholder: "Chercher…";
            text: Courses.course-search-text;
            init => { self.take-focus(); }
            edited(text) => { Courses.course-search(text); }
        }
        if Courses.empty: SmallText { text: "Aucun circuit"; }
        if !Courses.empty && root.narrow: Rectangle {
            background: Theme.card;
            border-radius: Theme.card-radius;
            border-width: Theme.card-outline-width;
            border-color: Theme.card-outline;
            VerticalLayout {
                padding: Theme.space-small;
                CourseRows { narrow: true; }
            }
        }
        if !Courses.empty && !root.narrow: Flickable {
            vertical-stretch: 1;
            content-height: rows.preferred-height;
            rows := CourseRows { width: parent.width; }
        }
        if Courses.empty || root.narrow: Rectangle { vertical-stretch: 1; }
    }
}

// The alert, always the height of the settings next to it. Its detail opens in a bubble.
component AlertPill inherits Rectangle {
    in property <bool> compact;

    height: Theme.zone;
    border-radius: self.height / 2;
    border-width: Theme.attention-outline;
    border-color: Theme.to-handle-outline;
    background: zone.has-hover ? Theme.tab-hover : Theme.card;
    accessible-role: button;
    accessible-label: Courses.alert-title;
    HorizontalLayout {
        padding-left: Theme.button-margin;
        padding-right: Theme.button-margin;
        spacing: Theme.space;
        VerticalLayout {
            alignment: center;
            Image {
                source: Icons.triangle-alert;
                colorize: Theme.problem.badge-text;
                width: Theme.button-icon;
                height: Theme.button-icon;
            }
        }
        Text {
            text: root.compact ? Courses.alert-count : Courses.alert-title;
            color: Theme.text;
            font-size: Theme.text-help;
            font-weight: Theme.weight-block-title;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Courses.bubble-right = root.absolute-position.x + root.width;
            Courses.bubble-top = root.absolute-position.y + root.height + Theme.space-small;
            Courses.open-bubble = 2;
        }
    }
}

// The settings of the page, summed up. They open in a bubble. `compact`: the title alone.
component SummaryZone inherits Rectangle {
    in property <bool> compact;

    height: Theme.zone;
    border-radius: Theme.field-radius;
    border-width: Theme.thin-outline-width;
    border-color: Theme.thin-outline;
    background: zone.has-hover ? Theme.tab-hover : transparent;
    accessible-role: button;
    accessible-label: "Réglages";
    HorizontalLayout {
        padding-left: Theme.space;
        padding-right: Theme.space;
        spacing: Theme.space;
        VerticalLayout {
            alignment: center;
            Image {
                source: Icons.settings;
                colorize: Theme.text;
                width: Theme.button-icon;
                height: Theme.button-icon;
            }
        }
        Text {
            horizontal-stretch: root.compact ? 1 : 0;
            text: "Tous les postes";
            color: Theme.text;
            font-size: Theme.text-block-title;
            font-weight: Theme.weight-block-title;
            vertical-alignment: center;
        }
        if !root.compact: HorizontalLayout {
            spacing: Theme.space;
            for chip in Courses.chips: SmallText {
                text: chip;
                wrap: no-wrap;
                vertical-alignment: center;
            }
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Courses.bubble-left = root.absolute-position.x;
            Courses.bubble-top = root.absolute-position.y + root.height + Theme.space-small;
            Courses.open-bubble = 1;
        }
    }
}

component SortMark {
    in property <bool> ascending;

    width: Theme.sort-mark;
    height: Theme.sort-mark;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.ascending ? "M5 1 L9 9 L1 9 Z" : "M5 9 L9 1 L1 1 Z";
        fill: Theme.text-secondary;
    }
}

component TableTitle inherits Rectangle {
    callback clicked();
    in property <string> label;
    in property <int> column;
    in property <int> tone: -1;
    in property <bool> centered;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Theme.space;
        alignment: root.centered ? center : start;
        spacing: Theme.space-small;
        if root.tone >= 0: VerticalLayout {
            alignment: center;
            CourseChip { tone: root.tone; }
        }
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.text-help;
            font-weight: Theme.weight-block-title;
            vertical-alignment: center;
        }
        if Courses.sort-column == root.column: VerticalLayout {
            alignment: center;
            SortMark { ascending: Courses.sort-ascending; }
        }
    }
}

component FixedRow {
    in property <string> label;
    in property <string> usage;
    in property <length> extra;

    min-height: Theme.zone;
    HorizontalLayout {
        VerticalLayout {
            width: Theme.table-code-width + root.extra;
            alignment: center;
            HorizontalLayout {
                padding-left: Theme.space;
                spacing: Theme.space-small;
                Text {
                    text: root.label;
                    color: Theme.text;
                    font-size: Theme.text-help;
                    font-weight: Theme.weight-block-title;
                }
            }
        }
        for column[i] in Courses.columns: Rectangle {
            width: Theme.table-course-width + root.extra;
            opacity: Courses.is-dimmed(i) ? Theme.dimmed-opacity : 1;
            Image {
                source: Icons.check;
                colorize: Courses.mark-color(column.tone);
                width: Theme.button-icon;
                height: Theme.button-icon;
            }
        }
        Text {
            width: Theme.table-usage-width + root.extra;
            text: root.usage;
            color: Theme.text-secondary;
            font-size: Theme.text-help;
            vertical-alignment: center;
        }
    }
}

component RowLine inherits Rectangle {
    height: Theme.thin-outline-width;
    background: Theme.separator;
}

// The titles stay at the top: only the rows scroll. It scrolls sideways when it does not fit.
component ControlsTable {
    property <length> total: Theme.table-code-width + Courses.columns.length * Theme.table-course-width + Theme.table-usage-width;
    property <length> extra: max(0px, (root.width - root.total) / (Courses.columns.length + 2));
    property <length> table-width: max(root.width, root.total);

    // Explicit size: the columns follow the width of the table, not the other way around.
    Flickable {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        content-width: root.table-width;
        content-height: root.height;
        VerticalLayout {
            width: root.table-width;
            height: root.height;
            HorizontalLayout {
                vertical-stretch: 0;
                height: Theme.table-header-height + Theme.space;
                TableTitle {
                    width: Theme.table-code-width + root.extra;
                    label: "Poste";
                    column: -1;
                    clicked => { Courses.sort-by(-1); }
                }
                for column[i] in Courses.columns: TableTitle {
                    width: Theme.table-course-width + root.extra;
                    label: column.name;
                    tone: column.tone;
                    column: i;
                    centered: true;
                    opacity: Courses.is-dimmed(i) ? Theme.dimmed-opacity : 1;
                    clicked => { Courses.sort-by(i); }
                }
                TableTitle {
                    width: Theme.table-usage-width + root.extra;
                    label: "Utilisation";
                    column: -2;
                    clicked => { Courses.sort-by(-2); }
                }
            }
            RowLine { vertical-stretch: 0; }
            Flickable {
                vertical-stretch: 1;
                content-height: lines.preferred-height;
                lines := VerticalLayout {
                    width: root.table-width;
                    FixedRow {
                        label: "Départ";
                        extra: root.extra;
                        usage: Courses.all-courses-usage;
                    }
                    for entry in Courses.rows: VerticalLayout {
                        RowLine { }
                        Rectangle {
                            min-height: Theme.zone;
                            background: entry.selected ? Theme.control-selected : transparent;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Courses.select-control(entry.code); }
                            }
                            HorizontalLayout {
                                VerticalLayout {
                                    width: Theme.table-code-width + root.extra;
                                    alignment: center;
                                    HorizontalLayout {
                                        padding-left: Theme.space;
                                        alignment: start;
                                        ControlTag {
                                            code: entry.code;
                                            unused: entry.unused;
                                            selected: entry.selected;
                                            clicked => { Courses.select-control(entry.code); }
                                        }
                                    }
                                }
                                for rank[i] in entry.ranks: Rectangle {
                                    width: Theme.table-course-width + root.extra;
                                    opacity: Courses.is-dimmed(i) ? Theme.dimmed-opacity : 1;
                                    RankDot {
                                        rank: rank;
                                        tone: Courses.columns[i].tone;
                                    }
                                }
                                Text {
                                    width: Theme.table-usage-width + root.extra;
                                    text: entry.usage;
                                    color: entry.unused ? Theme.to-check.badge-text : entry.shared ? Theme.purple : Theme.text-secondary;
                                    font-size: Theme.text-help;
                                    font-weight: entry.shared ? Theme.weight-block-title : Theme.weight-regular;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    RowLine { }
                    FixedRow {
                        label: "Arrivée";
                        extra: root.extra;
                        usage: Courses.all-courses-usage;
                    }
                }
            }
        }
    }
}

// On a phone: tag, ranks, number of courses.
component ControlsList {
    VerticalLayout {
        for entry[n] in Courses.rows: VerticalLayout {
            if n > 0: RowLine { }
            Rectangle {
                min-height: Theme.zone;
                background: entry.selected ? Theme.control-selected : transparent;
                TouchArea {
                    clicked => { Courses.select-control(entry.code); }
                }
                HorizontalLayout {
                    padding-left: Theme.narrow-margin;
                    padding-right: Theme.narrow-margin;
                    spacing: Theme.space;
                    VerticalLayout {
                        alignment: center;
                        ControlTag {
                            code: entry.code;
                            unused: entry.unused;
                            selected: entry.selected;
                            clicked => { Courses.select-control(entry.code); }
                        }
                    }
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: Theme.space-small;
                        for rank[i] in entry.ranks: VerticalLayout {
                            alignment: center;
                            if rank > 0: RankDot {
                                rank: rank;
                                tone: Courses.columns[i].tone;
                            }
                        }
                    }
                    Text {
                        text: entry.usage-short;
                        color: entry.unused ? Theme.to-check.badge-text : Theme.text-secondary;
                        font-size: Theme.text-help;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// The stops of a course, going to the next row instead of scrolling sideways.
component StopsFlow {
    in property <[SequenceStop]> stops;
    in property <int> tone;

    property <length> step: Theme.tag-min-width + Theme.sequence-link;
    property <length> row-height: Theme.rank-size + Theme.space-small + Theme.tag-height + Theme.space;
    property <int> per-row: max(1, floor((root.width + Theme.sequence-link) / root.step));

    height: ceil(root.stops.length / root.per-row) * root.row-height - Theme.space;
    for stop[i] in root.stops: Rectangle {
        x: mod(i, root.per-row) * root.step;
        y: floor(i / root.per-row) * root.row-height;
        width: Theme.tag-min-width;
        height: root.row-height - Theme.space;
        if mod(i, root.per-row) > 0: Rectangle {
            x: -Theme.sequence-link;
            y: (Theme.rank-size - Theme.map-trace) / 2;
            width: Theme.sequence-link;
            height: Theme.map-trace;
            background: Theme.purple;
        }
        RankDot {
            x: (parent.width - self.width) / 2;
            y: 0;
            rank: stop.rank;
            tone: root.tone;
        }
        ControlTag {
            x: 0;
            y: Theme.rank-size + Theme.space-small;
            width: parent.width;
            code: stop.code;
            selected: stop.selected;
            clicked => { Courses.select-control(stop.code); }
        }
    }
}

// Controls in no course, going to the next row as well.
component UnusedFlow {
    property <length> step: Theme.tag-min-width + Theme.space;
    property <length> row-height: Theme.tag-height + Theme.space;
    property <int> per-row: max(1, floor((root.width + Theme.space) / root.step));

    height: ceil(Courses.unused-codes.length / root.per-row) * root.row-height - Theme.space;
    for code[i] in Courses.unused-codes: ControlTag {
        x: mod(i, root.per-row) * root.step;
        y: floor(i / root.per-row) * root.row-height;
        width: Theme.tag-min-width;
        code: code;
        unused: true;
        clicked => { Courses.select-control(code); }
    }
}

component ControlsLines {
    VerticalLayout {
        padding: Theme.space-medium;
        spacing: Theme.space-medium;
        for line in Courses.lines: VerticalLayout {
            spacing: Theme.space;
            opacity: line.dimmed ? Theme.dimmed-opacity : 1;
            HorizontalLayout {
                alignment: start;
                spacing: Theme.space;
                VerticalLayout {
                    alignment: center;
                    CourseChip { tone: line.tone; }
                }
                Text {
                    text: line.name;
                    color: Theme.text;
                    font-size: Theme.text-help;
                    font-weight: Theme.weight-screen-title;
                }
                SmallText { text: line.count; wrap: no-wrap; }
            }
            StopsFlow {
                stops: line.stops;
                tone: line.tone;
            }
        }
        if Courses.unused-codes.length > 0: VerticalLayout {
            spacing: Theme.space;
            SmallText { text: "Dans aucun circuit"; }
            UnusedFlow { }
        }
    }
}

component MapMarkerView {
    in property <MapMarker> marker;

    x: 0;
    y: 0;
    width: 0;
    height: 0;
    opacity: root.marker.dimmed ? Theme.dimmed-opacity : 1;
    Rectangle {
        x: -Theme.map-marker / 2;
        y: -Theme.map-marker / 2;
        width: Theme.map-marker;
        height: Theme.map-marker;
        border-radius: self.width / 2;
        border-width: Theme.tag-outline;
        border-color: root.marker.unused ? Theme.tag-unused : Theme.purple;
        background: root.marker.selected ? Theme.tag-selected-background : transparent;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { Courses.select-control(root.marker.code); }
        }
    }
    ControlTag {
        x: Theme.map-marker / 2;
        y: -Theme.map-marker;
        code: root.marker.code;
        unused: root.marker.unused;
        selected: root.marker.selected;
        clicked => { Courses.select-control(root.marker.code); }
    }
}

component ControlsMap inherits Rectangle {
    clip: true;
    height: self.width * 0.6;

    Image {
        source: @image-url("../map/course-map.svg");
        width: 100%;
        height: 100%;
        image-fit: fill;
    }
    for trace in Courses.traces: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 600;
        viewbox-height: 360;
        commands: trace;
        stroke: Theme.purple;
        stroke-width: Theme.map-trace;
    }
    Path {
        x: Courses.start-x * root.width - self.width / 2;
        y: Courses.start-y * root.height - self.height / 2;
        width: Theme.map-marker;
        height: Theme.map-marker;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 4 21 19H3Z";
        stroke: Theme.purple;
        stroke-width: Theme.tag-outline;
    }
    Rectangle {
        x: Courses.finish-x * root.width - self.width / 2;
        y: Courses.finish-y * root.height - self.height / 2;
        width: Theme.map-marker;
        height: Theme.map-marker;
        border-radius: self.width / 2;
        border-width: Theme.tag-outline;
        border-color: Theme.purple;
        Rectangle {
            width: Theme.map-marker / 2;
            height: Theme.map-marker / 2;
            border-radius: self.width / 2;
            border-width: Theme.tag-outline;
            border-color: Theme.purple;
        }
    }
    for marker in Courses.markers: MapMarkerView {
        x: marker.x * root.width;
        y: marker.y * root.height;
        marker: marker;
    }
}

export component ControlDetail inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.card-radius;
    border-width: Theme.tag-outline;
    border-color: Theme.purple;

    VerticalLayout {
        padding: Theme.space-medium;
        spacing: Theme.button-margin;
        alignment: start;
        HorizontalLayout {
            spacing: Theme.space;
            VerticalLayout {
                alignment: center;
                ControlTag { code: Courses.detail-code; selected: true; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: "Poste " + Courses.detail-code;
                    color: Theme.text;
                    font-size: Theme.text-body;
                    font-weight: Theme.weight-screen-title;
                }
                SmallText { text: Courses.detail-subtitle; }
            }
            Rectangle {
                width: Theme.zone;
                height: Theme.zone;
                Image {
                    source: Icons.x;
                    colorize: Theme.text-secondary;
                    width: Theme.button-icon;
                    height: Theme.button-icon;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Courses.close-detail(); }
                }
            }
        }
        if Courses.detail-courses.length > 0: SmallText { text: "Circuits · rang · avant et après"; }
        for course in Courses.detail-courses: HorizontalLayout {
            spacing: Theme.space;
            VerticalLayout {
                alignment: center;
                CourseChip { tone: course.tone; }
            }
            Text {
                horizontal-stretch: 1;
                text: course.name;
                color: Theme.text;
                font-size: Theme.text-help;
                font-weight: Theme.weight-block-title;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            SmallText { text: course.rank; wrap: no-wrap; vertical-alignment: center; }
            HorizontalLayout {
                spacing: Theme.space-small;
                ControlTag { code: course.before; }
                ControlTag { code: Courses.detail-code; selected: true; }
                ControlTag { code: course.after; }
            }
        }
        Text {
            text: Courses.detail-entrants;
            color: Theme.text-secondary;
            font-size: Theme.text-help;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.space;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: Theme.toggle-width;
                    height: Theme.toggle-height;
                    border-radius: self.height / 2;
                    background: Theme.toggle-off;
                    Rectangle {
                        x: (parent.height - self.height) / 2;
                        width: Theme.toggle-knob-size;
                        height: Theme.toggle-knob-size;
                        border-radius: self.width / 2;
                        background: Theme.toggle-knob;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: "Boîtier double";
                    color: Theme.text;
                    font-size: Theme.text-help;
                }
                SmallText { text: "deux boîtiers, même code"; }
            }
        }
        HorizontalLayout {
            alignment: start;
            SecondaryButton { label: "Neutraliser…"; danger: true; }
        }
    }
}

// The settings on the left, the alert on the right: always one row of the same height.
component TopRow {
    HorizontalLayout {
        spacing: Theme.button-margin;
        SummaryZone { }
        Rectangle { horizontal-stretch: 1; }
        if Courses.alert-title != "": AlertPill { }
    }
}

component HighlightChip inherits Rectangle {
    callback clicked();
    in property <string> label;
    in property <int> tone;
    in property <bool> active;

    width: Theme.highlight-chip-width;
    height: Theme.zone;
    accessible-role: button;
    accessible-label: root.label;
    Rectangle {
        height: Theme.highlight-chip-height;
        border-radius: self.height / 2;
        background: root.active ? Theme.active-tab-background : zone.has-hover ? Theme.tab-hover : Theme.surface;
        HorizontalLayout {
            alignment: center;
            spacing: Theme.space-small;
            if root.tone >= 0: VerticalLayout {
                alignment: center;
                CourseChip { tone: root.tone; }
            }
            Text {
                text: root.label;
                color: root.active ? Theme.active-tab-text : Theme.text;
                font-size: Theme.text-help;
                font-weight: Theme.weight-block-title;
                vertical-alignment: center;
            }
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The filter of the view: small chips, going to the next row when they do not fit.
component HighlightFlow {
    property <length> step: Theme.highlight-chip-width + Theme.space-small;
    property <int> per-row: max(1, floor((root.width + Theme.space-small) / root.step));

    height: ceil(Courses.highlights.length / root.per-row) * Theme.zone;
    for item[i] in Courses.highlights: HighlightChip {
        x: mod(i, root.per-row) * root.step;
        y: floor(i / root.per-row) * Theme.zone;
        label: item.label;
        tone: i - 1;
        active: Courses.active-highlight == i;
        clicked => { Courses.select-highlight(i); }
    }
}

// What the card shows and how, and only that: the view and the search, then the filter.
component ViewRow {
    in property <bool> narrow;
    in property <length> available-width;

    property <bool> search-open: Courses.code-search-text != "";
    property <bool> search-below: !root.narrow
        && root.available-width < 3 * Theme.space + Theme.view-tabs-width + Theme.code-search-width;

    VerticalLayout {
        padding: Theme.space;
        spacing: Theme.space;
        HorizontalLayout {
            spacing: Theme.space;
            Tabs {
                tabs: root.narrow ? Courses.views-narrow : Courses.views;
                active: Courses.active-view;
                clicked(i) => { Courses.select-view(i); }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.narrow: SearchToggle {
                open: root.search-open;
                clicked => {
                    if root.search-open {
                        Courses.code-search("");
                    }
                    root.search-open = !root.search-open;
                }
            }
            if !root.narrow && !root.search-below: VerticalLayout {
                alignment: center;
                InputField {
                    width: Theme.code-search-width;
                    placeholder: "Chercher un code…";
                    input-kind: InputType.number;
                    text: Courses.code-search-text;
                    edited(text) => { Courses.code-search(text); }
                }
            }
        }
        if root.search-below: InputField {
            placeholder: "Chercher un code…";
            input-kind: InputType.number;
            text: Courses.code-search-text;
            edited(text) => { Courses.code-search(text); }
        }
        if root.narrow && root.search-open: InputField {
            placeholder: "Chercher un code…";
            input-kind: InputType.number;
            text: Courses.code-search-text;
            init => { self.take-focus(); }
            edited(text) => { Courses.code-search(text); }
        }
        if !root.narrow: HorizontalLayout {
            spacing: Theme.space;
            VerticalLayout {
                alignment: start;
                SmallText {
                    height: Theme.zone;
                    text: "Mettre en avant";
                    wrap: no-wrap;
                    vertical-alignment: center;
                }
            }
            HighlightFlow { horizontal-stretch: 1; }
        }
    }
}

// The content next to the list: all controls, or one course (next step).
component AllControls {
    in property <LayoutMode> layout-mode;
    in property <length> available-width;

    property <bool> narrow: root.layout-mode == LayoutMode.narrow;

    VerticalLayout {
        spacing: root.narrow ? Theme.button-margin : Theme.space;
        if root.narrow: HorizontalLayout {
            spacing: Theme.space;
            SecondaryButton {
                label: "‹";
                clicked => { Courses.select-course(-2); }
            }
            SummaryZone {
                horizontal-stretch: 1;
                compact: true;
            }
            if Courses.alert-title != "": AlertPill { compact: true; }
        }
        HorizontalLayout {
            vertical-stretch: 0;
            // In line with the buttons of the column, which sit inside its card.
            padding-top: root.narrow ? 0 : Theme.space;
            spacing: Theme.space;
            SecondaryButton {
                label: root.layout-mode == LayoutMode.wide ? "Ajouter des postes" : "Ajouter";
                icon: Icons.plus;
                has-icon: true;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        // On a phone the page scrolls. Otherwise the card fills the height and its content scrolls.
        Rectangle {
            vertical-stretch: root.narrow ? 0 : 1;
            background: Theme.card;
            border-radius: Theme.card-radius;
            border-width: Theme.card-outline-width;
            border-color: Theme.card-outline;
            clip: true;
            VerticalLayout {
                ViewRow {
                    vertical-stretch: 0;
                    narrow: root.narrow;
                    available-width: root.available-width;
                }
                RowLine { vertical-stretch: 0; }
                if Courses.active-view == 0 && !root.narrow: ControlsTable { vertical-stretch: 1; }
                if Courses.active-view != 1 && root.narrow: ControlsList { }
                if Courses.active-view == 1 && root.narrow: ControlsLines { }
                if Courses.active-view == 1 && !root.narrow: Flickable {
                    vertical-stretch: 1;
                    content-height: lines.preferred-height;
                    lines := ControlsLines { width: parent.width; }
                }
                if Courses.active-view == 2 && !root.narrow: Flickable {
                    vertical-stretch: 1;
                    content-height: map.height;
                    map := ControlsMap { width: parent.width; }
                }
            }
        }
    }
}

component OneCourse {
    in property <LayoutMode> layout-mode;

    VerticalLayout {
        alignment: start;
        spacing: Theme.button-margin;
        HorizontalLayout {
            spacing: Theme.space;
            if root.layout-mode == LayoutMode.narrow: VerticalLayout {
                alignment: start;
                SecondaryButton {
                    label: "‹";
                    clicked => { Courses.select-course(-2); }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: Courses.course-title;
                color: Theme.text;
                font-size: Theme.text-screen-title;
                font-weight: Theme.weight-screen-title;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

component BandSummary inherits Text {
    text: Courses.summary;
    color: Theme.text;
    font-size: Theme.text-help;
    font-weight: Theme.weight-block-title;
    vertical-alignment: center;
    wrap: word-wrap;
}

export component CoursesPage {
    in property <LayoutMode> layout-mode;
    in property <length> available-width;

    property <bool> detail-beside: root.layout-mode == LayoutMode.wide && Courses.detail-open;
    property <length> content-width: root.available-width - Theme.course-list-width - Theme.button-margin
        - (root.detail-beside ? Theme.control-detail-width + Theme.button-margin : 0px);

    VerticalLayout {
        spacing: Theme.button-margin;
        if root.layout-mode == LayoutMode.narrow: VerticalLayout {
            if Courses.list-only || Courses.empty: CourseList { narrow: true; }
            if !Courses.list-only && !Courses.empty && !Courses.course-selected: AllControls {
                layout-mode: root.layout-mode;
                available-width: root.available-width;
            }
            if !Courses.list-only && !Courses.empty && Courses.course-selected: OneCourse { layout-mode: root.layout-mode; }
        }
        if root.layout-mode != LayoutMode.narrow && !Courses.empty && !Courses.course-selected: TopRow { vertical-stretch: 0; }
        if root.layout-mode != LayoutMode.narrow: HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.button-margin;
            CourseList { width: Theme.course-list-width; }
            if !Courses.empty && !Courses.course-selected: AllControls {
                horizontal-stretch: 1;
                layout-mode: root.layout-mode;
                available-width: root.content-width;
            }
            if !Courses.empty && Courses.course-selected: OneCourse {
                horizontal-stretch: 1;
                layout-mode: root.layout-mode;
            }
            if root.detail-beside: VerticalLayout {
                alignment: start;
                width: Theme.control-detail-width;
                ControlDetail { }
            }
            if Courses.empty: Rectangle { horizontal-stretch: 1; }
        }
    }
}

// Stays at the bottom of the window, whatever the page scrolls to.
export component CoursesBand {
    in property <LayoutMode> layout-mode;
    in property <length> left-margin;
    in property <length> right-margin;
    in property <length> bottom-margin;

    property <bool> narrow: root.layout-mode == LayoutMode.narrow;

    VerticalLayout {
        padding-left: root.left-margin;
        padding-right: root.right-margin;
        padding-bottom: root.bottom-margin + Theme.space-small;
        RowLine { }
        if root.narrow: VerticalLayout {
            padding-top: Theme.space;
            BandSummary { }
            HorizontalLayout {
                spacing: Theme.space;
                alignment: end;
                SecondaryButton { label: "Imprimer"; }
                SecondaryButton { label: "Exporter"; }
            }
        }
        if !root.narrow: HorizontalLayout {
            padding-top: Theme.space-small;
            spacing: Theme.space;
            BandSummary { horizontal-stretch: 1; }
            SecondaryButton { label: "Imprimer"; }
            SecondaryButton { label: "Exporter"; }
        }
    }
}

// On medium and narrow layouts, the detail opens over the page.
export component DetailOverlay {
    TouchArea {
        clicked => { Courses.close-detail(); }
    }
    Rectangle {
        background: Theme.overlay-veil;
        panel := ControlDetail {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(Theme.detail-overlay-width, parent.width - 2 * Theme.narrow-margin);
            height: self.preferred-height;
            TouchArea { }
        }
    }
}

component BubbleLabel inherits Text {
    color: Theme.text;
    font-size: Theme.text-help;
    font-weight: Theme.weight-block-title;
    vertical-alignment: center;
    wrap: word-wrap;
}

component SettingsBubble {
    VerticalLayout {
        padding: Theme.space-medium;
        spacing: Theme.button-margin;
        HorizontalLayout {
            spacing: Theme.space;
            BubbleLabel { horizontal-stretch: 1; text: "Analyse"; }
            Tabs {
                tabs: [{ label: "Rien" }, { label: "Coureurs inscrits" }];
                active: 0;
            }
        }
        HorizontalLayout {
            spacing: Theme.space;
            BubbleLabel { horizontal-stretch: 1; text: "Tronçons non comptés"; }
            SecondaryButton {
                label: "Tronçon";
                icon: Icons.plus;
                has-icon: true;
            }
        }
        HorizontalLayout {
            spacing: Theme.space;
            BubbleLabel { horizontal-stretch: 1; text: Courses.chips[1]; }
            SecondaryButton { label: "Importer"; }
        }
    }
}

// One line per problem, each with its button.
component AlertBubble {
    VerticalLayout {
        padding: Theme.space-medium;
        spacing: Theme.space;
        Text {
            text: Courses.alert-title;
            color: Theme.text;
            font-size: Theme.text-label;
            font-weight: Theme.weight-screen-title;
            wrap: word-wrap;
        }
        SmallText { text: Courses.alert-detail; }
        for code in Courses.unused-codes: HorizontalLayout {
            spacing: Theme.space;
            VerticalLayout {
                alignment: center;
                ControlTag { code: code; unused: true; }
            }
            Rectangle { horizontal-stretch: 1; }
            PrimaryButton {
                label: "Le voir";
                in-row: true;
                clicked => {
                    Courses.open-bubble = 0;
                    Courses.select-control(code);
                }
            }
        }
    }
}

// A bubble opens under what was clicked, and closes when clicking anywhere else.
export component BubbleOverlay {
    in property <length> margin;

    property <length> bubble-width: min(Theme.bubble-width, root.width - 2 * root.margin);
    property <length> wanted-x: Courses.open-bubble == 2 ? Courses.bubble-right - root.bubble-width : Courses.bubble-left;

    TouchArea {
        clicked => { Courses.open-bubble = 0; }
    }
    Rectangle {
        x: clamp(root.wanted-x, root.margin, root.width - root.bubble-width - root.margin);
        y: Courses.bubble-top;
        width: root.bubble-width;
        height: content.preferred-height;
        background: Theme.card;
        border-radius: Theme.card-radius;
        border-width: Theme.thin-outline-width;
        border-color: Theme.thin-outline;
        drop-shadow-blur: Theme.demo-shadow;
        drop-shadow-color: Theme.bubble-shadow;
        TouchArea { }
        content := VerticalLayout {
            if Courses.open-bubble == 1: SettingsBubble { }
            if Courses.open-bubble == 2: AlertBubble { }
        }
    }
}
